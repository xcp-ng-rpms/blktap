From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Mon, 9 Mar 2026 14:10:35 +0100
Subject: [PATCH] tapdisk: server: avoid expected signals for threads

Signals must be handled by the main thread.

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
---
 drivers/tapdisk-server.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/tapdisk-server.c b/drivers/tapdisk-server.c
index dbda793e..ba87b753 100644
--- a/drivers/tapdisk-server.c
+++ b/drivers/tapdisk-server.c
@@ -957,6 +957,15 @@ int
 tapdisk_server_complete(void)
 {
 	int err;
+	sigset_t set;
+
+	sigemptyset(&set);
+	sigaddset(&set, SIGBUS);
+	sigaddset(&set, SIGXFSZ);
+	sigaddset(&set, SIGUSR1);
+	sigaddset(&set, SIGUSR2);
+	sigaddset(&set, SIGHUP);
+	pthread_sigmask(SIG_BLOCK, &set, NULL);
 
 	server.rw_backend = get_libaio_backend();
 	server.ro_backend = get_libaio_backend();
