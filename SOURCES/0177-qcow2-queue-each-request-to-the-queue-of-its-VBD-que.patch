From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varaganat <emmanuel.varagnat@vates.tech>
Date: Mon, 9 Feb 2026 10:44:30 +0100
Subject: [PATCH] qcow2: queue each request to the queue of its VBD queue

The requests were spread round-robin over the qcow2 queues. Queue each
of them to the qcow2 queue matching the VBD queue it was queued to: the
queue of its ring for the guest requests, or queue 0 for the requests
of the NBD server, e.g. for the mirror of a storage migration.

Have one qcow2 queue per blkif queue (BLKIF_MAX_QUEUES).

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
---
 drivers/block-qcow2.c | 41 +++++++++++++++++++++++++++--------------
 drivers/tapdisk.h     |  4 ++--
 drivers/td-req.c      |  3 +++
 drivers/td-req.h      |  5 +++++
 4 files changed, 37 insertions(+), 16 deletions(-)

diff --git a/drivers/block-qcow2.c b/drivers/block-qcow2.c
index 64ac1817..44d181f6 100644
--- a/drivers/block-qcow2.c
+++ b/drivers/block-qcow2.c
@@ -73,6 +73,7 @@
 #include "tapdisk-disktype.h"
 #include "tapdisk-storage.h"
 //#include "block-crypto.h"
+#include "td-req.h"
 
 #define DEBUGGING   2
 
@@ -108,8 +109,8 @@ enum qcow2_ops {
 struct qcow2_state;
 struct qcow2_request;
 
-#define QCOW2_REQS TAPDISK_DATA_REQUESTS
-#define QCOW2_QUEUE_COUNT 2
+#define QCOW2_REQS           TAPDISK_DATA_REQUESTS  // XXX: was 352 initially
+#define QCOW2_QUEUE_COUNT    BLKIF_MAX_QUEUES
 
 struct qcow2_request {
 	int                     error;
@@ -1119,16 +1120,28 @@ do_aio_write(struct qcow2_state *s, struct qcow2_request *req)
 static int
 schedule_request(struct qcow2_state *s, const td_request_t *treq, enum qcow2_ops op)
 {
-	static uint32_t queue_nr;
-	struct qcow2_queue *q = &s->queue[((queue_nr++) % QCOW2_QUEUE_COUNT)];
-	struct qcow2_request *req = NULL;
+        struct qcow2_queue *q;
+        struct qcow2_request *req;
+        td_queue_id_t qid = 0;
 
-	req = alloc_qcow2_request(q);
-	if (!req)
-		return -EBUSY;
+        /*
+         * The queue of the VBD the request was queued to: not only guest
+         * requests from a ring (struct td_xenblkif_req), but also requests
+         * of the NBD server, e.g. for the mirror of a storage migration.
+         */
+        if (treq->vreq && treq->vreq->vqueue)
+                qid = treq->vreq->vqueue - treq->vreq->vqueue->vbd->queues;
+
+        ASSERT(qid < ARRAY_SIZE(s->queue));
+        q = &s->queue[qid];
 
-	req->treq  = *treq;
-	req->op    = op;
+        req = alloc_qcow2_request(q /*, queue_idx */);
+        if (!req)
+            return -EBUSY;
+
+        req->treq  = *treq;
+        req->op    = op;
+        //req->q     = ???;
 
 	pthread_mutex_lock(&q->lock);
 	QSIMPLEQ_INSERT_TAIL(&q->inflight, req, list);
@@ -1144,7 +1157,7 @@ schedule_request(struct qcow2_state *s, const td_request_t *treq, enum qcow2_ops
 		treq->image->name, treq->sec, treq->secs,
 		treq->buf, req->id);
 
-	return 0;
+        return 0;
 }
 
 static void
@@ -1182,7 +1195,7 @@ int
 qcow2_commit(td_driver_t *driver, const char *name)
 {
 	struct qcow2_state *s = (struct qcow2_state *)driver->data;
-	struct qcow2_queue *q = &s->queue[0];
+	struct qcow2_queue *q = &s->queue[0];  // TODO: always that one ?
 	struct qcow2_request *req;
 	int err;
 
@@ -1271,7 +1284,7 @@ int
 qcow2_query_commit_job(td_driver_t *driver, td_query_t *query)
 {
 	struct qcow2_state *s = (struct qcow2_state *)driver->data;
-	struct qcow2_queue *q = &s->queue[0];
+	struct qcow2_queue *q = &s->queue[0];  // TODO: always that one ?
 	struct qcow2_request *req;
 	int err;
 
@@ -1371,7 +1384,7 @@ int
 qcow2_cancel_commit_job(td_driver_t *driver, bool wait)
 {
 	struct qcow2_state *s = (struct qcow2_state *)driver->data;
-	struct qcow2_queue *q = &s->queue[0];
+	struct qcow2_queue *q = &s->queue[0];  // TODO: always that one ?
 	struct qcow2_request *req;
 	int err;
 
diff --git a/drivers/tapdisk.h b/drivers/tapdisk.h
index 5da0e567..0aa67079 100644
--- a/drivers/tapdisk.h
+++ b/drivers/tapdisk.h
@@ -163,7 +163,7 @@ struct td_iovec {
 };
 
 struct td_vbd_request {
-	int                         op;
+	int                         op;   /* TODO: use propoer type */
 	td_sector_t                 sec;
 
 #ifdef HAVE_LTTNG
@@ -194,7 +194,7 @@ struct td_vbd_request {
 };
 
 struct td_request {
-	int                          op;
+	int                          op;  /* TODO: use proper type */
 	void                        *buf;
 
 	int                          status;
diff --git a/drivers/td-req.c b/drivers/td-req.c
index 0d6f4750..23f83d6f 100644
--- a/drivers/td-req.c
+++ b/drivers/td-req.c
@@ -971,6 +971,7 @@ tapdisk_xenblkif_reqs_init(struct td_blkif_queue* queue)
     void *buf;
     int i = 0;
     int err = 0;
+    td_queue_id_t qid = tapdisk_xenblkif_queue_id(queue);
 
     ASSERT(queue);
 
@@ -983,6 +984,8 @@ tapdisk_xenblkif_reqs_init(struct td_blkif_queue* queue)
         err = -errno;
         goto fail;
     }
+    for(int i = 0; i < queue->ring_size; i++)
+	queue->reqs[i].queue_idx = qid;
 
     queue->reqs_free =
         malloc(queue->ring_size * sizeof(blkif_request_t *));
diff --git a/drivers/td-req.h b/drivers/td-req.h
index 3563612b..2623aecb 100644
--- a/drivers/td-req.h
+++ b/drivers/td-req.h
@@ -54,6 +54,11 @@ struct td_xenblkif_req {
      */
     blkif_request_t msg;
 
+    /*
+     * Queue number the request is originating from.
+     */
+    td_queue_id_t queue_idx;
+
     /**
      * tapdisk's representation of the request.
      */
