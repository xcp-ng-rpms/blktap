+/*
+ * Writer thread: take the next child block, wait for the reader to fill
+ * its slot, merge it into the parent and give the slot back. Stops after
+ * the last block, or when any writer fails.
+ */
+static void *
+coalesce_writer(void *arg)
+{
+	uint32_t n;
+	int64_t ret;
+	struct coalesce_ctx *c = arg;
+
+	pthread_mutex_lock(&c->lock);
+	for (;;) {
+		n = c->next;
+		if (n >= c->nblocks || c->stop)
+			break;
+		c->next++;
+
+		while (c->produced <= n && !c->stop)
+			pthread_cond_wait(&c->cond, &c->lock);
+		if (c->produced <= n)
+			break;
+		pthread_mutex_unlock(&c->lock);
+
+		ret = vhd_util_coalesce_block(c, &c->slots[n % COALESCE_SLOTS]);
+
+		pthread_mutex_lock(&c->lock);
+		if (ret < 0) {
+			if (!c->err)
+				c->err = ret;
+			c->stop = 1;
+		} else
+			c->coalesced += ret;
+		c->busy[n % COALESCE_SLOTS] = 0;
+		c->merged++;
+		pthread_cond_broadcast(&c->cond);
+	}
+	pthread_mutex_unlock(&c->lock);
+
+	return NULL;
+}
