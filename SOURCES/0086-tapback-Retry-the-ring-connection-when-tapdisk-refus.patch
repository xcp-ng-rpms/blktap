From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
Date: Tue, 10 Nov 2026 11:45:49 +0100
Subject: [PATCH] tapback: Retry the ring connection when tapdisk refuses it
 with EBUSY

tapdisk is going to refuse to connect a new ring while a previous ring
of the same VBD, made dead by a frontend reset, still has requests in
flight: requests of the two rings would not be ordered against each
other. It answers EBUSY, and tapback must try again later.

tapback only acts on XenStore watches, and nothing is written to
XenStore when the dead ring drains. Until now an error from
tap_ctl_connect_xenblkif() just failed frontend_changed(), and the
frontend stayed in Initialised with no further attempt.

On EBUSY, connect_tap() logs once at INFO and xenbus_connect() marks
the device with connect_retry and returns success: the frontend waits
for the backend, as it does while there is no tapdisk yet. While a
device of the back-end is marked, the main loop wakes up every
TAPBACK_CONNECT_RETRY_MS (100 ms) and tapback_backend_retry_connect()
runs frontend_changed() again for it, provided the frontend is still
Initialised or Connected. A frontend that closed in the meantime is
not retried. The flag goes away with the device when it is removed.

An older tapdisk never answers EBUSY, so this changes nothing with it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
---
 tapback/frontend.c | 77 ++++++++++++++++++++++++++++++++++++++++++++++
 tapback/tapback.c  | 18 +++++++++--
 tapback/tapback.h  | 26 ++++++++++++++++
 3 files changed, 119 insertions(+), 2 deletions(-)

diff --git a/tapback/frontend.c b/tapback/frontend.c
index 65b8ffca..19e6baab 100644
--- a/tapback/frontend.c
+++ b/tapback/frontend.c
@@ -236,6 +236,16 @@ connect_tap(vbd_t * const device)
             INFO(device, "tapdisk[%d] minor=%d already connected to the "
 					"shared ring\n", device->tap->pid, device->tap->minor);
             err = 0;
+        } else if (err == EBUSY) {
+            /*
+             * A previous ring of the VBD still has requests in flight, the
+             * caller retries the connection later.
+             */
+            if (!device->connect_retry)
+                INFO(device, "tapdisk[%d] minor=%d still has requests in "
+                        "flight on a previous ring, will retry\n",
+                        device->tap->pid, device->tap->minor);
+            goto out;
         } else {
             WARN(device, "tapdisk[%d] failed to connect to the shared "
                     "ring: %s\n", device->tap->pid, strerror(err));
@@ -370,6 +380,22 @@ xenbus_connect(vbd_t *device) {
      */
     if (err == ESRCH)
         goto out;
+    /*
+     * The tapdisk refused the connection until a previous ring of the VBD
+     * has drained: tapback_backend_retry_connect() tries again later. This
+     * is not an error, the front-end just waits for the back-end.
+     */
+    if (err == EBUSY) {
+        device->connect_retry = true;
+        err = 0;
+        goto out;
+    }
+    if (device->connect_retry) {
+        device->connect_retry = false;
+        if (!err)
+            INFO(device, "tapdisk[%d] minor=%d connected to the shared ring "
+                    "after retrying\n", device->tap->pid, device->tap->minor);
+    }
     /*
      * Even if tapdisk is already connected to the shared ring, we continue
      * connecting since we don't know how far the connection process had gone
@@ -477,6 +503,57 @@ frontend_changed(vbd_t * const device, const XenbusState state)
     return err;
 }
 
+bool
+tapback_backend_connect_retry_pending(backend_t *backend)
+{
+    vbd_t *device = NULL, *next = NULL;
+
+    ASSERT(backend);
+
+    if (tapback_is_master(backend))
+        return false;
+
+    tapback_backend_for_each_device(backend, device, next) {
+        if (device->connect_retry)
+            return true;
+    }
+
+    return false;
+}
+
+void
+tapback_backend_retry_connect(backend_t *backend)
+{
+    vbd_t *device = NULL, *next = NULL;
+    int err;
+
+    ASSERT(backend);
+
+    if (tapback_is_master(backend))
+        return;
+
+    tapback_backend_for_each_device(backend, device, next) {
+        if (!device->connect_retry)
+            continue;
+
+        /*
+         * The front-end may have moved on since the tapdisk refused the
+         * connection, e.g. closed the device: then there is nothing to retry.
+         * Otherwise xenbus_connect() sets connect_retry again if the tapdisk
+         * still refuses it.
+         */
+        device->connect_retry = false;
+        if (device->frontend_state != XenbusStateInitialised &&
+                device->frontend_state != XenbusStateConnected)
+            continue;
+
+        err = frontend_changed(device, device->frontend_state);
+        if (err)
+            WARN(device, "failed to retry connecting to the front-end: %s\n",
+                    strerror(abs(err)));
+    }
+}
+
 int
 tapback_backend_handle_otherend_watch(backend_t *backend,
 		const char * const path)
diff --git a/tapback/tapback.c b/tapback/tapback.c
index 71dc72f4..e8bb018a 100644
--- a/tapback/tapback.c
+++ b/tapback/tapback.c
@@ -448,14 +448,26 @@ tapback_backend_run(backend_t *backend)
     do {
         fd_set rfds;
         int nfds = 0;
+        struct timeval tv, *timeout = NULL;
 
         FD_ZERO(&rfds);
         FD_SET(fd, &rfds);
 
+        /*
+         * A tapdisk refused to connect a VBD until a previous ring of it has
+         * drained: nothing in XenStore will tell us when that happens, so wake
+         * up periodically to retry.
+         */
+        if (tapback_backend_connect_retry_pending(backend)) {
+            tv.tv_sec = 0;
+            tv.tv_usec = TAPBACK_CONNECT_RETRY_MS * 1000;
+            timeout = &tv;
+        }
+
         /*
          * poll the fd for changes in the XenStore path we're interested in
          */
-        nfds = select(fd + 1, &rfds, NULL, NULL, NULL);
+        nfds = select(fd + 1, &rfds, NULL, NULL, timeout);
         if (nfds == -1) {
             if (likely(errno == EINTR))
                 continue;
@@ -464,7 +476,9 @@ tapback_backend_run(backend_t *backend)
             break;
         }
 
-        if (FD_ISSET(fd, &rfds))
+        if (nfds == 0)
+            tapback_backend_retry_connect(backend);
+        else if (FD_ISSET(fd, &rfds))
             tapback_read_watch(backend);
         DBG(NULL, "--\n");
     } while (1);
diff --git a/tapback/tapback.h b/tapback/tapback.h
index 330d0e6a..56957967 100644
--- a/tapback/tapback.h
+++ b/tapback/tapback.h
@@ -267,6 +267,13 @@ typedef struct vbd {
      */
     bool connected;
 
+    /**
+     * Indicates that the tapdisk refused to connect to the shared ring because
+     * a previous ring of the VBD still has requests in flight, and that the
+     * connection must be retried.
+     */
+    bool connect_retry;
+
     /**
      * Descriptor of the tapdisk process serving this virtual block device. We
      * need this until the end of the VBD's lifetime in order to disconnect
@@ -511,6 +518,25 @@ xenbus_switch_state(vbd_t * const device, const XenbusState state);
 int
 frontend_changed(vbd_t * const device, const XenbusState state);
 
+/**
+ * How often the connection of a VBD whose tapdisk refused it is retried, in
+ * milliseconds.
+ */
+#define TAPBACK_CONNECT_RETRY_MS    100
+
+/**
+ * Tells whether a VBD of this back-end waits for its connection to be retried.
+ */
+bool
+tapback_backend_connect_retry_pending(backend_t *backend);
+
+/**
+ * Retries the connection of each VBD of this back-end whose tapdisk refused
+ * it.
+ */
+void
+tapback_backend_retry_connect(backend_t *backend);
+
 /**
  * Returns the current domain ID or -errno.
  */
