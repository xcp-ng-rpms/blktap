From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Mon, 26 Jan 2026 13:40:16 +0100
Subject: [PATCH] tapdisk: improve a trace

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
---
 tapback/backend.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tapback/backend.c b/tapback/backend.c
index 60d69e9f..81fa853f 100644
--- a/tapback/backend.c
+++ b/tapback/backend.c
@@ -478,7 +478,7 @@ physical_device_changed(vbd_t *device) {
 
     err = find_tapdisk(device->minor, device->tap);
     if (err) {
-        WARN(device, "error looking for tapdisk: %s\n", strerror(-err));
+        WARN(device, "error looking for tapdisk minor=%d: %s\n", device->minor, strerror(-err));
         goto out;
     }
 
