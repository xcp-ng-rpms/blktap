From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Mon, 13 Apr 2026 14:19:08 +0200
Subject: [PATCH] tapdisk: remove uneeded struct keyword in malloc

---
 drivers/td-req.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/td-req.c b/drivers/td-req.c
index 39fe0700..1dcb36aa 100644
--- a/drivers/td-req.c
+++ b/drivers/td-req.c
@@ -969,7 +969,7 @@ tapdisk_xenblkif_reqs_init(struct td_xenblkif *td_blkif)
     }
 
     td_blkif->reqs_free =
-        malloc(td_blkif->ring_size * sizeof(struct blkif_request_t *));
+        malloc(td_blkif->ring_size * sizeof(blkif_request_t *));
     if (!td_blkif->reqs_free) {
         err = -errno;
         goto fail;
