From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
Date: Wed, 10 Jun 2026 17:02:38 +0200
Subject: [PATCH] vhd: check the length at the limit to throw ENAMETOOLONG

Signed-off-by: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
---
 lvm/lvm-util.c         |  4 ++--
 vhd/lib/libvhd-index.c | 12 ++++++------
 vhd/lib/libvhd.c       |  2 +-
 3 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/lvm/lvm-util.c b/lvm/lvm-util.c
index ab22c38c..e3719359 100644
--- a/lvm/lvm-util.c
+++ b/lvm/lvm-util.c
@@ -102,7 +102,7 @@ lvm_parse_pv(struct vg *vg, const char *name, int pvs, uint64_t start)
 	if (i == pvs)
 		return -ENOMEM;
 
-	err = lvm_copy_name(pv->name, name, sizeof(pv->name) - 1);
+	err = lvm_copy_name(pv->name, name, sizeof(pv->name));
 	if (err)
 		return err;
 
@@ -286,7 +286,7 @@ lvm_scan_lvs(struct vg *vg)
 		lv->segments      = segs;
 		lv->first_segment = seg;
 
-		err = lvm_copy_name(lv->name, name, sizeof(lv->name) - 1);
+		err = lvm_copy_name(lv->name, name, sizeof(lv->name));
 		if (err)
 			goto out;
 		err = -EINVAL;
diff --git a/vhd/lib/libvhd-index.c b/vhd/lib/libvhd-index.c
index 6b6aa4e1..5b9d399a 100644
--- a/vhd/lib/libvhd-index.c
+++ b/vhd/lib/libvhd-index.c
@@ -267,8 +267,8 @@ vhdi_path_expand(const char *src, vhdi_path_t *dest, int *err)
 		return NULL;
 	}
 
-	len = strnlen(absolute_path, VHD_MAX_NAME_LEN - 1);
-	if (len == VHD_MAX_NAME_LEN - 1) {
+	len = strnlen(absolute_path, VHD_MAX_NAME_LEN);
+	if (len == VHD_MAX_NAME_LEN) {
 		free(absolute_path);
 		*err = -ENAMETOOLONG;
 		return NULL;
@@ -710,8 +710,8 @@ vhdi_copy_path_to(vhdi_path_t *path, const char *src, const char *dest, size_t d
 		goto out;
 	}
 
-	len = strnlen(relative_path, VHD_MAX_NAME_LEN - 1);
-	if (len == VHD_MAX_NAME_LEN - 1) {
+	len = strnlen(relative_path, VHD_MAX_NAME_LEN);
+	if (len == VHD_MAX_NAME_LEN) {
 		err = -ENAMETOOLONG;
 		goto out;
 	}
@@ -1158,8 +1158,8 @@ vhdi_file_table_add(const char *name, const char *file, vhdi_file_id_t *_fid)
 	fid   = 0;
 	*_fid = 0;
 
-        len = strnlen(file, VHD_MAX_NAME_LEN - 1);
-	if (len == VHD_MAX_NAME_LEN - 1)
+	len = strnlen(file, VHD_MAX_NAME_LEN);
+	if (len == VHD_MAX_NAME_LEN)
 		return -ENAMETOOLONG;
 
 	err = vhdi_file_table_next_fid(name, file, &fid);
diff --git a/vhd/lib/libvhd.c b/vhd/lib/libvhd.c
index 830e95ae..e02e88e5 100644
--- a/vhd/lib/libvhd.c
+++ b/vhd/lib/libvhd.c
@@ -3320,7 +3320,7 @@ __vhd_create(const char *name, const char *parent, uint64_t bytes, int type,
 		return -EINVAL;
 	}
 
-	if (strnlen(name, VHD_MAX_NAME_LEN - 1) == VHD_MAX_NAME_LEN - 1)
+	if (strnlen(name, VHD_MAX_NAME_LEN) == VHD_MAX_NAME_LEN)
 		return -ENAMETOOLONG;
 
 	if (bytes && mbytes && mbytes < bytes)
