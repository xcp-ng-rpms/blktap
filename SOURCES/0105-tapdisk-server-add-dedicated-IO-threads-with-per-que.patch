 static void
 tapdisk_vbd_check_requests_for_issue(td_vbd_t *vbd)
 {
+	bool issue;
+
 	pthread_mutex_lock(&vbd->mutex);
-	if (!list_empty(&vbd->new_requests) ||
-	    !list_empty(&vbd->failed_requests)) {
