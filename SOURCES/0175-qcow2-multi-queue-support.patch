Subject: [PATCH] qcow2: multi-queue support

---
 drivers/block-qcow2.c | 441 ++++++++++++++++++++++++------------------
 1 file changed, 258 insertions(+), 183 deletions(-)

diff --git a/drivers/block-qcow2.c b/drivers/block-qcow2.c
index c40c75b6..ec06a275 100644
--- a/drivers/block-qcow2.c
+++ b/drivers/block-qcow2.c
@@ -79,10 +79,8 @@
