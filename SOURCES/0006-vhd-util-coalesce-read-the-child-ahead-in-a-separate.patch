+/*
+ * Reader thread: read the child blocks into the ring of slots, ahead of
+ * the writer. Stops after a read error, which the writer gets in the
+ * failed slot, or when the writer gives up.
+ */
+static void *
+coalesce_reader(void *arg)
+{
+	int stop;
+	uint32_t n;
+	struct coalesce_slot *s;
+	struct coalesce_ctx *c = arg;
+
+	for (n = 0; n < c->nblocks; n++) {
+		pthread_mutex_lock(&c->lock);
+		while (n - c->consumed >= COALESCE_SLOTS && !c->stop)
+			pthread_cond_wait(&c->cond, &c->lock);
+		stop = c->stop;
+		pthread_mutex_unlock(&c->lock);
+		if (stop)
+			break;
+
+		s        = &c->slots[n % COALESCE_SLOTS];
+		s->block = c->blocks[n];
+		s->count = coalesce_read_child(c, s);
+
+		pthread_mutex_lock(&c->lock);
+		c->produced = n + 1;
+		pthread_cond_broadcast(&c->cond);
+		pthread_mutex_unlock(&c->lock);
+
+		if (s->count < 0)
+			break;
+	}
+
+	return NULL;
+}
+
+/* Wait for the reader to fill the slot of the n-th child block */
+static struct coalesce_slot *
+coalesce_get_slot(struct coalesce_ctx *c, uint32_t n)
+{
+	pthread_mutex_lock(&c->lock);
+	while (c->produced <= n)
+		pthread_cond_wait(&c->cond, &c->lock);
+	pthread_mutex_unlock(&c->lock);
+
+	return &c->slots[n % COALESCE_SLOTS];
+}
+
+/* Give the slot of the n-th child block back to the reader */
+static void
+coalesce_put_slot(struct coalesce_ctx *c, uint32_t n)
+{
+	pthread_mutex_lock(&c->lock);
+	c->consumed = n + 1;
+	pthread_cond_broadcast(&c->cond);
+	pthread_mutex_unlock(&c->lock);
+}
+
+/* Make the reader stop, and wait for it */
+static void
+coalesce_stop_reader(struct coalesce_ctx *c)
+{
+	pthread_mutex_lock(&c->lock);
+	c->stop = 1;
+	pthread_cond_broadcast(&c->cond);
+	pthread_mutex_unlock(&c->lock);
+
+	pthread_join(c->reader, NULL);
+}
