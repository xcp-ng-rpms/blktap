@@ -1033,11 +986,11 @@ fail:
 	for (int qid = 0; qid < ARRAY_SIZE(server.io_threads); qid++) {
 		if (server.io_threads[qid].tid)
 			pthread_cancel(server.io_threads[qid].tid);
+
