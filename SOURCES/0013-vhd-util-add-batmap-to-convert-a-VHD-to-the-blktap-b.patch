+/*
+ * Convert a dynamic or differencing VHD created by another implementation
+ * (Hyper-V, Virtual PC, qemu...) to the blktap layout with a batmap, in
+ * place.
+ *
+ * The batmap lives right after the BAT: a 512 byte header, then one bit
+ * per BAT entry. Other implementations usually put the parent locator
+ * data or the first data blocks there. Locator data in the way is moved
+ * right after the batmap, where it overlaps no other locator data: libvhd
+ * expects all the metadata before the data blocks (vhd_end_of_headers()).
+ * Blocks in the way of the batmap and of the moved locator data are moved
+ * past the end of data.
+ *
+ * libvhd only looks for a batmap when the footer says the VHD was created
+ * by tapdisk, so the steps are ordered for an interrupted conversion to
+ * leave a valid VHD, without the batmap until the very end:
+ *
+ *  1. copy the blocks in the way past the end of data, after moving the
+ *     trailing footer of a file further if needed, then point the BAT
+ *     entries to the copies;
+ *  2. copy the locator data in the way to its new place, now free, then
+ *     point the header locators to the copies;
+ *  3. write the batmap, with the bits of the full blocks set, over data
+ *     nothing points to anymore;
+ *  4. switch the footer creator to tapdisk, then truncate the file after
+ *     it and update the backup footer.
+ *
+ * Each write is synced before the next one depending on it. The header is
+ * written in place: VHD has no backup header, so a write torn by a crash
+ * in step 2 would leave it with a bad checksum.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "libvhd.h"
+
+struct batmap_move {
+	int            loc;         /* parent locator data, or a block */
+	uint32_t       idx;         /* locator or block index */
+	off64_t        from;
+	off64_t        to;
+	size_t         size;
+};
+
+struct batmap_conv {
+	vhd_context_t *vhd;
+	off64_t        start;       /* batmap header */
+	off64_t        end;         /* end of the map */
+	off64_t        meta_end;    /* end of the moved locator data */
+	uint32_t       map_secs;
+	off64_t        eod;         /* end of data once converted */
+
+	struct batmap_move *moves;
+	int            nmoves;
+};
+
+static int
+overlaps(off64_t a, off64_t a_end, off64_t b, off64_t b_end)
+{
+	return a < b_end && b < a_end;
+}
+
+static int
+cmp_move(const void *a, const void *b)
+{
+	const struct batmap_move *x = a, *y = b;
+
+	return (x->from > y->from) - (x->from < y->from);
+}
+
+static int
+batmap_add_move(struct batmap_conv *conv, int loc, uint32_t idx,
+		off64_t from, size_t size)
+{
+	struct batmap_move *m;
+
+	m = realloc(conv->moves, (conv->nmoves + 1) * sizeof(*m));
+	if (!m)
+		return -ENOMEM;
+	conv->moves = m;
+
+	m       = &conv->moves[conv->nmoves++];
+	m->loc  = loc;
+	m->idx  = idx;
+	m->from = from;
+	m->size = size;
+	m->to   = 0;
+	return 0;
+}
+
+/*
+ * Find room for moved locator data after the batmap, overlapping neither
+ * the data of any locator nor the moved locator data already placed.
+ */
+static off64_t
+batmap_place_locator(struct batmap_conv *conv, size_t size)
+{
+	int i, moved;
+	off64_t pos, off, end;
+	vhd_parent_locator_t *loc;
+	vhd_context_t *vhd = conv->vhd;
+
+	pos = conv->end;
+again:
+	for (i = 0; i < vhd_parent_locator_count(vhd); i++) {
+		loc = &vhd->header.loc[i];
+		if (loc->code == PLAT_CODE_NONE)
+			continue;
+
+		off = loc->data_offset;
+		end = vhd_bytes_padded(off + vhd_parent_locator_size(loc));
+		if (overlaps(pos, pos + size, off, end)) {
+			pos = end;
+			goto again;
+		}
+	}
+
+	for (i = 0, moved = 0; i < conv->nmoves; i++) {
+		struct batmap_move *m = &conv->moves[i];
+
+		if (m->loc && m->to &&
+		    overlaps(pos, pos + size, m->to, m->to + m->size)) {
+			pos = m->to + m->size;
+			moved = 1;
+			break;
+		}
+	}
+	if (moved)
+		goto again;
+
+	return pos;
+}
+
+/*
+ * List the locator data and the blocks in the way of the batmap, and
+ * place their copies: the locator data right after the batmap, the
+ * blocks past the end of data, in the same order. Blocks keep their data
+ * aligned on a page, as tapdisk allocates them.
+ */
+static int
+batmap_plan(struct batmap_conv *conv)
+{
+	int i, err;
+	off64_t off, end, next;
+	uint64_t sec;
+	uint32_t gap, spp;
+	vhd_parent_locator_t *loc;
+	vhd_context_t *vhd = conv->vhd;
+	size_t block_size  = vhd_sectors_to_bytes(vhd->bm_secs + vhd->spb);
+
+	if (overlaps(vhd->footer.data_offset,
+		     vhd->footer.data_offset + sizeof(vhd_header_t),
+		     conv->start, conv->end)) {
+		printf("the header is in the way of the batmap\n");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < vhd_parent_locator_count(vhd); i++) {
+		loc = &vhd->header.loc[i];
+		if (loc->code == PLAT_CODE_NONE)
+			continue;
+
+		off = loc->data_offset;
+		end = off + vhd_parent_locator_size(loc);
+		if (end == off) {
+			if (off >= conv->start && off < conv->end) {
+				printf("parent locator %d of unknown size "
+				       "in the way of the batmap\n", i);
+				return -EINVAL;
+			}
+			continue;
+		}
+
+		if (!overlaps(off, end, conv->start, conv->end))
+			continue;
+
+		err = batmap_add_move(conv, 1, i, off, end - off);
+		if (err)
+			return err;
+	}
+
+	conv->meta_end = conv->end;
+	for (i = 0; i < conv->nmoves; i++) {
+		struct batmap_move *m = &conv->moves[i];
+
+		m->to = batmap_place_locator(conv, m->size);
+		if (m->to + (off64_t)m->size > conv->meta_end)
+			conv->meta_end = m->to + m->size;
+	}
+
+	for (i = 0; i < vhd->bat.entries; i++) {
+		if (vhd->bat.bat[i] == DD_BLK_UNUSED)
+			continue;
+
+		off = vhd_sectors_to_bytes(vhd->bat.bat[i]);
+		if (!overlaps(off, off + block_size,
+			      conv->start, conv->meta_end))
+			continue;
+
+		err = batmap_add_move(conv, 0, i, off, block_size);
+		if (err)
+			return err;
+	}
+
+	qsort(conv->moves, conv->nmoves, sizeof(*conv->moves), cmp_move);
+
+	/* without a batmap yet: the end of the BAT, locators and blocks */
+	err = vhd_end_of_data(vhd, &next);
+	if (err)
+		return err;
+
+	if (next < conv->meta_end)
+		next = conv->meta_end;
+
+	spp = getpagesize() >> VHD_SECTOR_SHIFT;
+
+	for (i = 0; i < conv->nmoves; i++) {
+		struct batmap_move *m = &conv->moves[i];
+
+		if (m->loc)
+			continue;
+
+		sec = next >> VHD_SECTOR_SHIFT;
+		gap = 0;
+		if ((sec + vhd->bm_secs) % spp)
+			gap = spp - ((sec + vhd->bm_secs) % spp);
+		next += vhd_sectors_to_bytes(gap);
+
+		if ((next >> VHD_SECTOR_SHIFT) > UINT32_MAX)
+			return -EFBIG;
+
+		m->to = next;
+		next += m->size;
+	}
+
+	conv->eod = next;
+	return 0;
+}
+
+/*
+ * Copy the blocks, or the locator data, in the way and sync them, then
+ * point the BAT, or the header, to the copies and sync it.
+ */
+static int
+batmap_move(struct batmap_conv *conv, int loc)
+{
+	int i, err;
+	char *buf;
+	size_t size;
+	uint32_t first, last;
+	vhd_context_t *vhd = conv->vhd;
+
+	size = 0;
+	for (i = 0; i < conv->nmoves; i++)
+		if (conv->moves[i].loc == loc && conv->moves[i].size > size)
+			size = conv->moves[i].size;
+
+	if (!size)
+		return 0;
+
+	err = posix_memalign((void **)&buf, 4096, size);
+	if (err)
+		return -err;
+
+	for (i = 0; i < conv->nmoves; i++) {
+		struct batmap_move *m = &conv->moves[i];
+
+		if (m->loc != loc)
+			continue;
+
+		err = vhd_pread(vhd, buf, m->size, m->from);
+		if (err)
+			goto out;
+
+		err = vhd_pwrite(vhd, buf, m->size, m->to);
+		if (err)
+			goto out;
+	}
+
+	if (fdatasync(vhd->fd)) {
+		err = -errno;
+		goto out;
+	}
+
+	first = UINT32_MAX;
+	last  = 0;
+
+	for (i = 0; i < conv->nmoves; i++) {
+		struct batmap_move *m = &conv->moves[i];
+
+		if (m->loc != loc)
+			continue;
+
+		if (loc) {
+			vhd->header.loc[m->idx].data_offset = m->to;
+			continue;
+		}
+
+		vhd->bat.bat[m->idx] = m->to >> VHD_SECTOR_SHIFT;
+		if (m->idx < first)
+			first = m->idx;
+		if (m->idx > last)
+			last = m->idx;
+	}
+
+	if (loc)
+		err = vhd_write_header(vhd, &vhd->header);
+	else
+		err = vhd_write_bat_range(vhd, first, last);
+	if (err)
+		goto out;
+
+	if (fdatasync(vhd->fd))
+		err = -errno;
+
+out:
+	free(buf);
+	return err;
+}
+
+/*
+ * Write the batmap with the bits of the blocks whose bitmap is full set,
+ * and sync it. Returns the number of full blocks.
+ */
+static int
+batmap_write(struct batmap_conv *conv)
+{
+	int err, full;
+	char *map, *bitmap, *hdr;
+	uint32_t i, j;
+	vhd_batmap_t batmap;
+	vhd_context_t *vhd = conv->vhd;
+	size_t bm_bytes    = vhd_sectors_to_bytes(vhd->bm_secs);
+	size_t map_bytes   = vhd_sectors_to_bytes(conv->map_secs);
+
+	map = bitmap = hdr = NULL;
+
+	err = posix_memalign((void **)&map, 4096, map_bytes);
+	if (err)
+		goto fail;
+	err = posix_memalign((void **)&bitmap, 4096, bm_bytes);
+	if (err)
+		goto fail;
+	err = posix_memalign((void **)&hdr, 4096, VHD_SECTOR_SIZE);
+	if (err)
+		goto fail;
+
+	memset(map, 0, map_bytes);
+	full = 0;
+
+	for (i = 0; i < vhd->bat.entries; i++) {
+		if (vhd->bat.bat[i] == DD_BLK_UNUSED)
+			continue;
+
+		err = vhd_pread(vhd, bitmap, bm_bytes,
+				vhd_sectors_to_bytes(vhd->bat.bat[i]));
+		if (err)
+			goto out;
+
+		for (j = 0; j < vhd->spb; j++)
+			if (!test_bit(bitmap, j))
+				break;
+
+		if (j == vhd->spb) {
+			set_bit(map, i);
+			full++;
+		}
+	}
+
+	memset(&batmap, 0, sizeof(batmap));
+	memcpy(batmap.header.cookie, VHD_BATMAP_COOKIE,
+	       sizeof(batmap.header.cookie));
+	batmap.header.batmap_offset  = conv->start + VHD_SECTOR_SIZE;
+	batmap.header.batmap_size    = conv->map_secs;
+	batmap.header.batmap_version = VHD_BATMAP_CURRENT_VERSION;
+	batmap.map                   = map;
+	batmap.header.checksum       = vhd_checksum_batmap(vhd, &batmap);
+
+	err = vhd_pwrite(vhd, map, map_bytes, batmap.header.batmap_offset);
+	if (err)
+		goto out;
+
+	vhd_batmap_header_out(&batmap);
+	memset(hdr, 0, VHD_SECTOR_SIZE);
+	memcpy(hdr, &batmap.header, sizeof(batmap.header));
+
+	err = vhd_pwrite(vhd, hdr, VHD_SECTOR_SIZE, conv->start);
+	if (err)
+		goto out;
+
+	if (fdatasync(vhd->fd)) {
+		err = -errno;
+		goto out;
+	}
+
+	err = full;
+	goto out;
+
+fail:
+	err = -err;
+out:
+	free(map);
+	free(bitmap);
+	free(hdr);
+	return err;
+}
+
+static int
+vhd_util_batmap_convert(const char *name, int dry_run)
+{
+	int i, err, full, nlocs;
+	off64_t footer;
+	struct batmap_conv conv;
+	vhd_context_t vhd;
+
+	memset(&conv, 0, sizeof(conv));
+	conv.vhd = &vhd;
+
+	err = vhd_open(&vhd, name, dry_run ? VHD_OPEN_RDONLY : VHD_OPEN_RDWR);
+	if (err) {
+		printf("error opening %s: %d\n", name, err);
+		return err;
+	}
+
+	if (!vhd_type_dynamic(&vhd)) {
+		printf("%s: only dynamic and differencing VHDs have a batmap\n",
+		       name);
+		err = -EINVAL;
+		goto out;
+	}
+
+	if (vhd_has_batmap(&vhd)) {
+		vhd_footer_t backup;
+
+		printf("%s already has a batmap\n", name);
+
+		/* finish a conversion interrupted before the backup footer */
+		err = vhd_read_footer_at(&vhd, &backup, 0);
+		if (dry_run || (!err && !memcmp(&backup, &vhd.footer,
+						sizeof(backup))))
+			goto out;
+
+		err = vhd_write_footer_at(&vhd, &vhd.footer, 0);
+		if (!err && fdatasync(vhd.fd))
+			err = -errno;
+		if (err)
+			printf("error writing the backup footer: %d\n", err);
+		else
+			printf("backup footer updated\n");
+		goto out;
+	}
+
+	/* the batmap checksum and size assume VHD_BLOCK_SIZE blocks */
+	if (vhd.header.block_size != VHD_BLOCK_SIZE) {
+		printf("%s: unsupported block size %u, only %llu\n", name,
+		       vhd.header.block_size, VHD_BLOCK_SIZE);
+		err = -EINVAL;
+		goto out;
+	}
+
+	err = vhd_get_bat(&vhd);
+	if (err) {
+		printf("error reading the BAT of %s: %d\n", name, err);
+		goto out;
+	}
+
+	err = vhd_batmap_header_offset(&vhd, &conv.start);
+	if (err)
+		goto out;
+
+	conv.map_secs = secs_round_up_no_zero((vhd.header.max_bat_size + 7) >> 3);
+	conv.end      = conv.start + VHD_SECTOR_SIZE +
+		vhd_sectors_to_bytes(conv.map_secs);
+
+	err = batmap_plan(&conv);
+	if (err)
+		goto out;
+
+	err = vhd_footer_offset_at_eof(&vhd, &footer);
+	if (err)
+		goto out;
+
+	nlocs = 0;
+	for (i = 0; i < conv.nmoves; i++)
+		nlocs += conv.moves[i].loc;
+
+	printf("batmap at 0x%"PRIx64"-0x%"PRIx64", moving %d parent locators "
+	       "after it and %d blocks past the end of data\n",
+	       conv.start, conv.end, nlocs, conv.nmoves - nlocs);
+
+	if (vhd.is_block && conv.eod > footer) {
+		printf("%s: 0x%"PRIx64" more bytes needed\n", name,
+		       conv.eod - footer);
+		err = -ENOSPC;
+		goto out;
+	}
+
+	if (dry_run)
+		goto out;
+
+	/* keep a valid footer at the end of a file all along */
+	if (!vhd.is_block && conv.eod > footer) {
+		err = vhd_write_footer_at(&vhd, &vhd.footer, conv.eod);
+		if (!err && fdatasync(vhd.fd))
+			err = -errno;
+		if (err) {
+			printf("error moving the footer: %d\n", err);
+			goto out;
+		}
+	}
+
+	err = batmap_move(&conv, 0);
+	if (err) {
+		printf("error moving the blocks in the way: %d\n", err);
+		goto out;
+	}
+
+	err = batmap_move(&conv, 1);
+	if (err) {
+		printf("error moving the parent locators in the way: %d\n",
+		       err);
+		goto out;
+	}
+
+	full = batmap_write(&conv);
+	if (full < 0) {
+		err = full;
+		printf("error writing the batmap: %d\n", err);
+		goto out;
+	}
+
+	memset(vhd.footer.crtr_app, 0, sizeof(vhd.footer.crtr_app));
+	memcpy(vhd.footer.crtr_app, "tap", 3);
+	vhd.footer.crtr_ver = VHD_CURRENT_VERSION;
+
+	/* reads the batmap back, then truncates a file after the footer */
+	err = vhd_write_footer(&vhd, &vhd.footer);
+	if (err) {
+		printf("error writing the footer: %d\n", err);
+		goto out;
+	}
+
+	if (fdatasync(vhd.fd)) {
+		err = -errno;
+		goto out;
+	}
+
+	printf("%s converted, %d full blocks\n", name, full);
+
+out:
+	free(conv.moves);
+	vhd_close(&vhd);
+	return err;
+}
+
+int
+vhd_util_batmap(int argc, char **argv)
+{
+	char *name;
+	int c, dry_run;
+
+	name    = NULL;
+	dry_run = 0;
+
+	if (!argc || !argv)
+		goto usage;
+
+	optind = 0;
+	while ((c = getopt(argc, argv, "n:dh")) != -1) {
+		switch (c) {
+		case 'n':
+			name = optarg;
+			break;
+		case 'd':
+			dry_run = 1;
+			break;
+		case 'h':
+		default:
+			goto usage;
+		}
+	}
+
+	if (!name || optind != argc)
+		goto usage;
+
+	return vhd_util_batmap_convert(name, dry_run);
+
+usage:
+	printf("Add a batmap to a VHD created by another implementation, "
+	       "in place.\n"
+	       "The VHD must not be in use.\n"
+	       "options: <-n name> [-d dry run] [-h help]\n");
+	return -EINVAL;
+}
