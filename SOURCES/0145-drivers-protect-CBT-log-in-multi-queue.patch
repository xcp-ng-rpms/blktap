From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Tue, 6 Oct 2026 17:33:55 +0200
Subject: [PATCH] drivers: protect CBT log in multi-queue

---
 drivers/block-log.c | 13 ++++++++++++-
 drivers/block-log.h |  3 +++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/block-log.c b/drivers/block-log.c
index f5394db0..0273fa9b 100644
--- a/drivers/block-log.c
+++ b/drivers/block-log.c
@@ -47,10 +47,12 @@
 #define BITMAP_ENTRY(_nr, _bmap) ((unsigned long*)(_bmap + sizeof(struct cbt_log_metadata)))[((_nr)/BITS_PER_LONG)]
 #define BITMAP_SHIFT(_nr) ((_nr) % BITS_PER_LONG)
 
+#if 0
 static inline int test_bit(int nr, void* bmap)
 {
 	return (BITMAP_ENTRY(nr, bmap) >> BITMAP_SHIFT(nr)) & 1;
 }
+#endif
 
 static inline void set_bit(int nr, void* bmap)
 {
@@ -126,9 +128,13 @@ static int bitmap_set(struct tdlog_data* data, uint64_t block, int count)
 {
 	int i;
 
+	pthread_mutex_lock(&data->mutex);
+
 	for (i = 0; i < count; i++)
 		set_bit(block + i, data->bitmap);
 
+	pthread_mutex_unlock(&data->mutex);
+
 	return 0;
 }
 
@@ -138,8 +144,11 @@ static int bitmap_set(struct tdlog_data* data, uint64_t block, int count)
 static int tdlog_close(td_driver_t* driver)
 {
 	struct tdlog_data* data = (struct tdlog_data*)driver->data;
+
 	bitmap_free(data);
 
+	pthread_mutex_destroy(&data->mutex);
+
 	return 0;
 }
 
@@ -152,6 +161,8 @@ static int tdlog_open(td_driver_t* driver, const char *name,
 	memset(data, 0, sizeof(*data));
 	data->size = driver->info.size;
 
+	pthread_mutex_init(&data->mutex, NULL);
+
 	if ((rc = bitmap_init(data, driver->name))) {
 		tdlog_close(driver);
 		return rc;
@@ -191,7 +202,7 @@ static int tdlog_validate_parent(td_driver_t *driver,
 struct tap_disk tapdisk_log = {
 	.disk_type          = "tapdisk_log",
 	.private_data_size  = sizeof(struct tdlog_data),
-	.flags              = 0,
+	.flags              = TD_DRIVER_MULTIQUEUE,
 	.td_open            = tdlog_open,
 	.td_close           = tdlog_close,
 	.td_queue_read      = tdlog_queue_read,
diff --git a/drivers/block-log.h b/drivers/block-log.h
index 23bfb686..9c388fd4 100644
--- a/drivers/block-log.h
+++ b/drivers/block-log.h
@@ -18,11 +18,14 @@
 #ifndef __BLOCK_LOG_H__
 #define __BLOCK_LOG_H__
 
+#include <pthread.h>
+
 #include "cbt-util.h"
 
 struct tdlog_data {
 	uint64_t   	size;
 	void*		bitmap;
+	pthread_mutex_t mutex;
 };
 
 #endif
