From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Sun, 12 Apr 2026 08:04:14 +0200
Subject: [PATCH] tapdisk: improve errno handling on error and signal paths

Initialise err before the qcow2 commit/query bail-outs, fix the errno
sign in eventfd() logging, and drain the non-blocking signalfd while
reporting real read failures.
---
 drivers/block-qcow2.c    |  3 ++
 drivers/tapdisk-server.c | 72 +++++++++++++++++++++-------------------
 drivers/tapdisk-vbd.c    |  4 +--
 3 files changed, 43 insertions(+), 36 deletions(-)

diff --git a/drivers/block-qcow2.c b/drivers/block-qcow2.c
index 303c3c6e..c32c46bb 100644
--- a/drivers/block-qcow2.c
+++ b/drivers/block-qcow2.c
@@ -1024,12 +1024,14 @@ do_commit(struct qcow2_state *s, struct qcow2_request *req)
 	}
 	if (top_bs == NULL) {
 		DPRINTF("qcow2_commit: top '%s' doesn't exist\n", req->top);
+		err = -EINVAL;
 		goto signal_commit;
 	}
 	top_node = top_bs->node_name;
 	base_bs = bdrv_backing_chain_next(top_bs);
 	if (base_bs == NULL) {
 		DPRINTF("qcow2_commit: no base to commit in\n");
+		err = -EINVAL;
 		goto signal_commit;
 	}
 	base_node = base_bs->node_name;
@@ -1111,6 +1113,7 @@ do_query_commit_job(struct qcow2_state *s, struct qcow2_request *req)
 	if (!bjob) {
 		job_unlock();
 		DPRINTF("Qcow2: no job running.\n");
+		err = -ENOENT;
 		goto signal;
 	}
 
diff --git a/drivers/tapdisk-server.c b/drivers/tapdisk-server.c
index e4d4d935..0575ae13 100644
--- a/drivers/tapdisk-server.c
+++ b/drivers/tapdisk-server.c
@@ -426,45 +426,49 @@ tapdisk_server_signal_handler(event_id_t id, char mode __attribute__((unused)),
 	struct td_xenblkif *blkif;
 	static int xfsz_error_sent = 0;
 
-	size = read(server.sigfd, &fdsi, sizeof(fdsi));
-	if (size != sizeof(fdsi)) {
-		ERR(EFBIG, "failed to read signals");
-		return;
-	}
-
-	signal = fdsi.ssi_signo;
+	while ((size = read(server.sigfd, &fdsi, sizeof(fdsi))) > 0) {
+		if (size != sizeof(fdsi)) {
+			ERR(EFBIG, "failed to read signals");
+			continue;
+		}
 
-	switch (signal) {
-	case SIGBUS:
-		tapdisk_server_for_each_vbd(vbd, tmp)
-			tapdisk_vbd_close(vbd);
-		break;
+		signal = fdsi.ssi_signo;
 
-	case SIGXFSZ:
-		ERR(EFBIG, "received SIGXFSZ");
-		tapdisk_server_stop_vbds();
-		if (xfsz_error_sent)
+		switch (signal) {
+		case SIGBUS:
+			tapdisk_server_for_each_vbd(vbd, tmp)
+				tapdisk_vbd_close(vbd);
 			break;
 
-		xfsz_error_sent = 1;
-		break;
+		case SIGXFSZ:
+			ERR(EFBIG, "received SIGXFSZ");
+			tapdisk_server_stop_vbds();
+			if (xfsz_error_sent)
+				break;
 
-	case SIGUSR1:
-		DBG(TLOG_INFO, "debugging on signal %d\n", signal);
-		tapdisk_server_debug();
-		break;
+			xfsz_error_sent = 1;
+			break;
 
-	case SIGUSR2:
-		DBG(TLOG_INFO, "triggering polling on signal %d\n", signal);
-		tapdisk_server_for_each_vbd(vbd, tmp)
-			list_for_each_entry(blkif, &vbd->rings, entry)
-				tapdisk_start_polling(blkif);
-		break;
+		case SIGUSR1:
+			DBG(TLOG_INFO, "debugging on signal %d\n", signal);
+			tapdisk_server_debug();
+			break;
 
-	case SIGHUP:
-		tapdisk_server_event_set_timeout(server.tlog_reopen_evid, TV_ZERO);
-		break;
+		case SIGUSR2:
+			DBG(TLOG_INFO, "triggering polling on signal %d\n", signal);
+			tapdisk_server_for_each_vbd(vbd, tmp)
+				list_for_each_entry(blkif, &vbd->rings, entry)
+					tapdisk_start_polling(blkif);
+			break;
+
+		case SIGHUP:
+			tapdisk_server_event_set_timeout(server.tlog_reopen_evid, TV_ZERO);
+			break;
+		}
 	}
+
+	if (size < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+		ERR(errno, "failed to read signals: %s", strerror(errno));
 }
 
 
@@ -847,18 +851,18 @@ tapdisk_server_run()
 	sigaddset(&set, SIGUSR2);
 	sigaddset(&set, SIGHUP);
 	sigaddset(&set, SIGXFSZ);
-	server.sigfd = signalfd(-1, &set, 0);
+	server.sigfd = signalfd(-1, &set, SFD_NONBLOCK);
 	if (server.sigfd == -1) {
 		err = errno;
 		EPRINTF("failed to create a new signalfd: %s\n",
-			strerror(-err));
+			strerror(err));
 		goto out;
 	}
 
 	if (sigprocmask(SIG_BLOCK, &set, NULL) == -1) {
 		err = errno;
 		EPRINTF("failed to block signals we'd like to handle with signalfd: %s\n",
-			strerror(-err));
+			strerror(err));
 		goto out;
 	}
 
diff --git a/drivers/tapdisk-vbd.c b/drivers/tapdisk-vbd.c
index 52ac3aea..a622dd20 100644
--- a/drivers/tapdisk-vbd.c
+++ b/drivers/tapdisk-vbd.c
@@ -632,7 +632,7 @@ tapdisk_vbd_open_vdi(td_vbd_t *vbd, const char *name, td_flag_t flags, int prt_d
 
 		vbd->efd = eventfd(0, 0);
 		if (vbd->efd == -1) {
-			err = errno;
+			err = -errno;
 			ERROR("Failed to create eventfd: %s\n", strerror(-err));
 			goto fail;
 		}
@@ -1136,7 +1136,7 @@ tapdisk_vbd_commit(td_vbd_t *vbd, const char *name)
 	int err;
 
 	if (log) {
-		INFO("commit %s\n", name);
+		INFO("commit %s\n", name ? name : "(null)");
 	}
 
 	err = td_commit(tapdisk_vbd_first_non_log_image(vbd), name);
