 drivers/Makefile.am        |  2 --
 drivers/atomicio.c         | 65 --------------------------------------
 drivers/atomicio.h         | 33 -------------------
 drivers/libaio-backend.c   |  1 -
 drivers/posixaio-backend.c |  1 -
 6 files changed, 104 deletions(-)
 delete mode 100644 drivers/atomicio.c
 delete mode 100644 drivers/atomicio.h

