From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Tue, 13 Oct 2026 22:02:22 +0200
Subject: [PATCH] tapback: announce indirect segments to the front-ends

Write feature-max-indirect-segments, 32 by default as Linux front-ends use
by default, and pass it to tapdisk when connecting the ring. The option
-i/--indirect-segments changes it, 0 disabling indirect requests.

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
---
 control/tap-ctl-xen.c |  5 +++--
 include/tap-ctl.h     |  5 ++++-
 tapback/frontend.c    | 11 ++++++++++-
 tapback/tapback.c     | 24 ++++++++++++++++++++----
 tapback/tapback.h     | 14 ++++++++++++++
 5 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/control/tap-ctl-xen.c b/control/tap-ctl-xen.c
index 5fb1d1f9..d6f5e942 100644
--- a/control/tap-ctl-xen.c
+++ b/control/tap-ctl-xen.c
@@ -44,7 +44,8 @@ int
 tap_ctl_connect_xenblkif(const pid_t pid, const domid_t domid, const int devid,
 		int poll_duration, int poll_idle_threshold,
 		const grant_ref_t grefs[][8], const int order, const int queues,
-		const evtchn_port_t* ports, int proto, const char *pool_name, const int minor)
+		const evtchn_port_t* ports, int proto, const char *pool_name,
+		const unsigned int indirect_max_segments, const int minor)
 {
     tapdisk_message_t message;
     int i, q, err;
@@ -67,7 +68,7 @@ tap_ctl_connect_xenblkif(const pid_t pid, const domid_t domid, const int devid,
     message.u.blkif.order = order;
     message.u.blkif.proto = proto;
     message.u.blkif.persistent_grants = false;
-    message.u.blkif.indirect_max_segments = 0;
+    message.u.blkif.indirect_max_segments = indirect_max_segments;
     message.u.blkif.poll_duration = poll_duration;
     message.u.blkif.poll_idle_threshold = poll_idle_threshold;
     if (pool_name) {
diff --git a/include/tap-ctl.h b/include/tap-ctl.h
index 5fb1216b..3be95ca7 100644
--- a/include/tap-ctl.h
+++ b/include/tap-ctl.h
@@ -155,13 +155,16 @@ int tap_ctl_cancel_commit_job(const int id, const int minor, bool wait);
  * @param pool a string used as an identifier to group two or more VBDs
  * beloning to the same tapdisk process. For VBDs with the same pool name, a
  * single event channel is used.
+ * @param indirect_max_segments maximum number of segments of an indirect
+ * request, as announced to the front-end (0: no indirect requests)
  * @param minor
  * @returns 0 on success, a negative error code otherwise
  */
 int tap_ctl_connect_xenblkif(const pid_t pid, const domid_t domid, const int
 		devid, int poll_duration, int poll_idle_threshold,
 		const grant_ref_t grefs[][MAX_RING_PAGES], const int order, const int queues,
-		const evtchn_port_t* port, int proto, const char *pool, const int minor);
+		const evtchn_port_t* port, int proto, const char *pool,
+		const unsigned int indirect_max_segments, const int minor);
 
 /**
  * Instructs a tapdisk to disconnect from the shared ring.
diff --git a/tapback/frontend.c b/tapback/frontend.c
index 43a17392..ffa08f28 100644
--- a/tapback/frontend.c
+++ b/tapback/frontend.c
@@ -287,7 +287,7 @@ connect_tap(vbd_t * const device)
     if ((err = -tap_ctl_connect_xenblkif(device->tap->pid, device->domid,
                     device->devid, device->polling_duration, device->polling_idle_threshold,
                     grefs, order, nr_queues, ports, proto, NULL,
-                    device->minor))) {
+                    device->backend->indirect_segments, device->minor))) {
         /*
          * This happens if the tapback dameon gets restarted while there are
          * active VBDs.
@@ -366,6 +366,15 @@ connect_frontend(vbd_t *device) {
             break;
         }
 
+        if (device->backend->indirect_segments &&
+            (err = tapback_device_printf(device, xst,
+                    "feature-max-indirect-segments", true, "%u",
+                    device->backend->indirect_segments))) {
+            WARN(device, "failed to write feature-max-indirect-segments: %s\n",
+                 strerror(-err));
+            break;
+        }
+
         if ((err = tapback_device_printf(device, xst, "sector-size", true,
                         "%u", device->sector_size))) {
             WARN(device, "failed to write sector-size: %s\n", strerror(-err));
diff --git a/tapback/tapback.c b/tapback/tapback.c
index 407a5ce1..b863a17b 100644
--- a/tapback/tapback.c
+++ b/tapback/tapback.c
@@ -219,7 +219,8 @@ tapback_write_pid(const char *pidfile)
  */
 static inline backend_t *
 tapback_backend_create(const char *name, const char *pidfile,
-                       const domid_t domid, const bool barrier, const bool multiqueue)
+                       const domid_t domid, const bool barrier, const bool multiqueue,
+                       const unsigned int indirect_segments)
 {
     int err;
     int len;
@@ -256,6 +257,7 @@ tapback_backend_create(const char *name, const char *pidfile,
 
     backend->barrier = barrier;
     backend->multiqueue = multiqueue;
+    backend->indirect_segments = indirect_segments;
 
     backend->path = NULL;
 
@@ -507,7 +509,9 @@ usage(FILE * const stream, const char * const prog)
             "\t[-x|--domain domainID]\n"
             "\t[-b|--nobarrier]\n"
             "\t[-q|--noqueues]\n"
-            "\t[-n|--name backend_name (default: vbd3)]\n", prog);
+            "\t[-i|--indirect-segments NUM (default: %u, 0: no indirect requests)]\n"
+            "\t[-n|--name backend_name (default: vbd3)]\n", prog,
+            TAPBACK_INDIRECT_SEGMENTS);
 }
 
 extern char *optarg;
@@ -581,6 +585,7 @@ int main(int argc, char **argv)
     domid_t opt_domid = 0;
     bool opt_barrier = true;
     bool opt_queues = true;
+    unsigned int opt_indirect_segments = TAPBACK_INDIRECT_SEGMENTS;
 
 	if (access("/dev/xen/gntdev", F_OK ) == -1) {
 		WARN(NULL, "grant device does not exist\n");
@@ -609,11 +614,12 @@ int main(int argc, char **argv)
             {"domain", 1, NULL, 'x'},
             {"nobarrier", 0, NULL, 'b'},
             {"noqueues", 0, NULL, 'q'},
+            {"indirect-segments", 1, NULL, 'i'},
             {NULL, 0, NULL, 0},
         };
         int c;
 
-        c = getopt_long(argc, argv, "hdvn:p:x:bq", longopts, NULL);
+        c = getopt_long(argc, argv, "hdvn:p:x:bqi:", longopts, NULL);
         if (c < 0)
             break;
 
@@ -656,6 +662,16 @@ int main(int argc, char **argv)
         case 'q':
             opt_queues = false;
             break;
+        case 'i':
+            opt_indirect_segments = strtoul(optarg, &end, 0);
+            if (*end != 0 || end == optarg ||
+                opt_indirect_segments > TAPBACK_MAX_INDIRECT_SEGMENTS) {
+                WARN(NULL, "invalid number of indirect segments %s (max %u)\n",
+                     optarg, TAPBACK_MAX_INDIRECT_SEGMENTS);
+                err = EINVAL;
+                goto fail;
+            }
+            break;
         case '?':
             goto usage;
         }
@@ -690,7 +706,7 @@ int main(int argc, char **argv)
     }
 
     backend = tapback_backend_create(opt_name, opt_pidfile, opt_domid,
-                                     opt_barrier, opt_queues);
+                                     opt_barrier, opt_queues, opt_indirect_segments);
     if (!backend) {
         err = errno;
         WARN(NULL, "error creating back-end: %s\n", strerror(err));
diff --git a/tapback/tapback.h b/tapback/tapback.h
index 71e1993c..6b9312a1 100644
--- a/tapback/tapback.h
+++ b/tapback/tapback.h
@@ -98,6 +98,14 @@ int pretty_time(char *buf, unsigned char buf_len);
 #define PHYS_DEV_KEY		"physical-device"
 #define PHYS_DEV_PATH_KEY	"physical-device-path"
 #define HOTPLUG_STATUS_KEY	"hotplug-status"
+
+/*
+ * Indirect segments announced by default: what Linux front-ends use by
+ * default (xen_blkif_max_segments), and the maximum tapdisk supports
+ * (TD_MAX_INDIRECT_SEGMENTS).
+ */
+#define TAPBACK_INDIRECT_SEGMENTS	32
+#define TAPBACK_MAX_INDIRECT_SEGMENTS	256
 #define MODE_KEY		"mode"
 #define POLLING_DURATION	"polling-duration"
 #define POLLING_IDLE_THRESHOLD	"polling-idle-threshold"
@@ -209,6 +217,12 @@ typedef struct backend {
      * Tells whether we support discard.
      */
     bool discard;
+
+    /**
+     * Maximum number of segments of an indirect request announced to the
+     * front-ends, 0 for no indirect requests.
+     */
+    unsigned int indirect_segments;
 } backend_t;
 
 /**
