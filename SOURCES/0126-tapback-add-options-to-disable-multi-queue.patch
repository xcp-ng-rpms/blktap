diff --git a/tapback/tapback.sysconfig b/tapback/tapback.sysconfig
new file mode 100644
index 00000000..2ee4267e
--- /dev/null
+++ b/tapback/tapback.sysconfig
@@ -0,0 +1,11 @@
+# Extra command line options of tapback (see tapback --help), added after the
+# ones of tapback.service. Restart the service to apply them:
+#
+#   systemctl restart tapback
+#
+# -q: use a single queue for every VBD, i.e. disable multi-queue
+# -b: disable the barriers
+# -v: verbose
+#
+# TAPBACK_OPTS="-q"
+TAPBACK_OPTS=""
diff --git a/tapback/xenstore.c b/tapback/xenstore.c
index 3d786a0b..eed91c18 100644
--- a/tapback/xenstore.c
+++ b/tapback/xenstore.c
@@ -119,6 +119,27 @@ tapback_device_read_otherend(vbd_t * const device, xs_transaction_t xst,
             device->frontend_path, path);
 }
 
+int
+tapback_device_scanf(vbd_t * const device, xs_transaction_t xst,
+        const char * const path, const char * const fmt, ...)
+{
+    va_list ap;
+    int n = 0;
+    char *s = NULL;
+
+    ASSERT(device);
+    ASSERT(path);
+
+    if (!(s = tapback_device_read(device, xst, path)))
+        return -1;
+    va_start(ap, fmt);
+    n = vsscanf(s, fmt, ap);
+    free(s);
+    va_end(ap);
+
+    return n;
+}
+
 int
 tapback_device_scanf_otherend(vbd_t * const device, xs_transaction_t xst,
         const char * const path, const char * const fmt, ...)
