From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Fri, 2 Oct 2026 13:03:46 +0200
Subject: [PATCH] nbdserver: send a valid NBD error code in simple replies

The request callback copied the tapdisk error straight into the reply,
but tapdisk errors are negative errno values while the NBD protocol
expects a positive code among EPERM, EIO, ENOMEM, EINVAL, ENOSPC,
EOVERFLOW, ENOTSUP and ESHUTDOWN. A failed I/O was then reported as
e.g. 0xfffffffb instead of EIO.

Negate the error and map any value outside the allowed set to EIO.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/tapdisk-nbdserver.c | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/drivers/tapdisk-nbdserver.c b/drivers/tapdisk-nbdserver.c
index 7e9f2291..f33b267c 100644
--- a/drivers/tapdisk-nbdserver.c
+++ b/drivers/tapdisk-nbdserver.c
@@ -1024,6 +1024,29 @@ finish:
 	tapdisk_nbdserver_free_request(client, req, true);
 }
 
+/*
+ * Map a tapdisk error (negative errno) to one of the error values the
+ * NBD protocol allows in a reply. They match the Linux errno values.
+ */
+static uint32_t
+tapdisk_nbdserver_errno(int error)
+{
+	switch (-error) {
+	case 0:
+	case EPERM:
+	case EIO:
+	case ENOMEM:
+	case EINVAL:
+	case ENOSPC:
+	case EOVERFLOW:
+	case ENOTSUP:
+	case ESHUTDOWN:
+		return -error;
+	default:
+		return EIO;
+	}
+}
+
 static void
 __tapdisk_nbdserver_request_cb(td_vbd_request_t *vreq, int error,
 		void *token, int final)
@@ -1037,7 +1060,7 @@ __tapdisk_nbdserver_request_cb(td_vbd_request_t *vreq, int error,
 	int rc = 0;
 
 	reply.magic = htonl(NBD_REPLY_MAGIC);
-	reply.error = htonl(error);
+	reply.error = htonl(tapdisk_nbdserver_errno(error));
 	memcpy(reply.handle, req->id, sizeof(reply.handle));
 
 	gettimeofday(&now, NULL);
