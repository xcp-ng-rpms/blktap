From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
Date: Wed, 10 Jun 2026 17:12:31 +0200
Subject: [PATCH] lvm,vhd: use safe_strncpy when needed

This commit fixes the last stringop-truncation warnings.

Signed-off-by: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
---
 include/util.h   | 9 ++++-----
 lvm/lvm-util.c   | 4 ++--
 vhd/lib/libvhd.c | 4 ++--
 3 files changed, 8 insertions(+), 9 deletions(-)

diff --git a/include/util.h b/include/util.h
index 06cce42d..0e63a0a6 100644
--- a/include/util.h
+++ b/include/util.h
@@ -39,14 +39,13 @@
 /*
  * Strncpy variant that guarantees to terminate the string
  */
-static inline char *
+static inline void
 safe_strncpy(char *dest, const char *src, size_t n)
 {
-	char *pdest;
-	pdest = strncpy(dest, src, n - 1);
-	if (n > 0)
+	if (n > 0) {
+		strncpy(dest, src, n - 1);
 		dest[n - 1] = '\0';
-	return pdest;
+	}
 }
 
 #endif /* __TAPDISK_UTIL_H__ */
diff --git a/lvm/lvm-util.c b/lvm/lvm-util.c
index e3719359..d25e1d77 100644
--- a/lvm/lvm-util.c
+++ b/lvm/lvm-util.c
@@ -39,7 +39,6 @@
 #include <syslog.h>
 
 #include "lvm-util.h"
-#include "util.h"
 
 #define EPRINTF(_f, _a...)					\
 	do {							\
@@ -68,7 +67,8 @@ lvm_copy_name(char *dst, const char *src, size_t size)
 	if (strnlen(src, size) == size)
 		return -ENAMETOOLONG;
 
-	safe_strncpy(dst, src, size);
+	/* We can use strncpy safely here because we check src length just before. */
+	strncpy(dst, src, size);
 	return 0;
 }
 
diff --git a/vhd/lib/libvhd.c b/vhd/lib/libvhd.c
index e02e88e5..4152578a 100644
--- a/vhd/lib/libvhd.c
+++ b/vhd/lib/libvhd.c
@@ -57,7 +57,6 @@
 #include "relative-path.h"
 #include "canonpath.h"
 #include "compiler.h"
-#include "util.h"
 
 /* VHD uses an epoch of 12:00AM, Jan 1, 2000. This is the Unix timestamp for 
  * the start of the VHD epoch. */
@@ -2874,7 +2873,8 @@ vhd_initialize_footer(vhd_context_t *ctx, int type, uint64_t size)
 	ctx->footer.type         = type;
 	ctx->footer.saved        = 0;
 	ctx->footer.data_offset  = 0xFFFFFFFFFFFFFFFFULL;
-	safe_strncpy(ctx->footer.crtr_app, "tap", sizeof(ctx->footer.crtr_app));
+	/* strncpy is safe here because "tap" is literal. */
+	strncpy(ctx->footer.crtr_app, "tap", sizeof(ctx->footer.crtr_app));
 	uuid_generate(ctx->footer.uuid);
 }
 
