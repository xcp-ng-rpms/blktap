From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Thu, 5 Nov 2026 12:56:36 +0100
Subject: [PATCH] tapdisk: avoid kicking VBD from qcow2 thread

Let td_complete_request() enqueue completed requests, and postpone
VBD "kicking" in the IO queue thread.
Kick is responsible for grant-copy and kicking the guest. It is
quite CPU heavy and we want QCOW2 thread to complete as quick as
possible because every completes are running from the same thread
even with IOthreads.
This will also allow us batch grant-copy in the futur.

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
---
 drivers/block-qcow2.c    |  9 +++------
 drivers/tapdisk-server.c |  9 +--------
 drivers/tapdisk-server.h |  2 --
 drivers/tapdisk-vbd.c    | 24 ++++--------------------
 drivers/tapdisk-vbd.h    |  4 +++-
 5 files changed, 11 insertions(+), 37 deletions(-)

diff --git a/drivers/block-qcow2.c b/drivers/block-qcow2.c
index 9fb9827b..fee1904a 100644
--- a/drivers/block-qcow2.c
+++ b/drivers/block-qcow2.c
@@ -948,7 +948,6 @@ signal_completion(struct qcow2_request *r)
 {
 	struct qcow2_queue *q = r->queue;
 	struct qcow2_state *s = q->state;
-	td_vbd_queue_t *queue = r->treq.vreq->vqueue;
 	int notify;
 
 	pthread_mutex_lock(&s->lock);
@@ -959,13 +958,11 @@ signal_completion(struct qcow2_request *r)
 	pthread_mutex_unlock(&s->lock);
 
 	notify = td_complete_request(&r->treq, r->error);
+	(void)notify;
+
 	DBG(TLOG_DBG, "lsec: 0x%08"PRIx64", blk: 0x%04x, "
 		"err: %d\n", r->treq.sec, r->treq.secs, r->error);
-	/* Also on error: the generic wake-up of remote completions skips qcow2 */
-	if (notify) {
-		tapdisk_vbd_kick(queue, true);
-		s->kick++;
-	}
+
 	free_qcow2_request(q, r);
 
 	s->returned++;
diff --git a/drivers/tapdisk-server.c b/drivers/tapdisk-server.c
index 10648af9..a3cf0ba1 100644
--- a/drivers/tapdisk-server.c
+++ b/drivers/tapdisk-server.c
@@ -358,13 +358,6 @@ tapdisk_server_io_scheduler_wake(td_queue_id_t qid)
 	tapdisk_server_io_thread_wake(qid);
 }
 
-bool
-tapdisk_server_in_io_thread(td_queue_id_t qid)
-{
-	ASSERT(qid < ARRAY_SIZE(server.io_threads));
-	return pthread_equal(pthread_self(), server.io_threads[qid].tid);
-}
-
 event_id_t
 tapdisk_server_register_io_event(td_queue_id_t qid, char mode, int fd,
 				 struct timeval timeout, event_cb_t cb, void *data)
@@ -479,7 +472,7 @@ tapdisk_server_kick_responses(td_queue_id_t qid)
 	td_vbd_t *vbd, *tmp;
 
 	tapdisk_server_for_each_vbd(vbd, tmp)
-		tapdisk_vbd_kick(&vbd->queues[qid], false);
+		tapdisk_vbd_kick(&vbd->queues[qid]);
 }
 
 static void
diff --git a/drivers/tapdisk-server.h b/drivers/tapdisk-server.h
index 60c6dcd7..2cb2b2c7 100644
--- a/drivers/tapdisk-server.h
+++ b/drivers/tapdisk-server.h
@@ -71,8 +71,6 @@ void tapdisk_server_unregister_io_event(td_queue_id_t qid, event_id_t);
 void tapdisk_server_mask_io_event(td_queue_id_t qid, event_id_t, int);
 void tapdisk_server_set_io_max_timeout(td_queue_id_t qid, int);
 void tapdisk_server_io_scheduler_wake(td_queue_id_t);
-/* Whether the caller runs on the IO thread of the queue */
-bool tapdisk_server_in_io_thread(td_queue_id_t qid);
 
 /*
  * Callable from IO threads: asks the main thread to reap the dead
diff --git a/drivers/tapdisk-vbd.c b/drivers/tapdisk-vbd.c
index b5883cb0..89233e55 100644
--- a/drivers/tapdisk-vbd.c
+++ b/drivers/tapdisk-vbd.c
@@ -74,7 +74,7 @@ static bool log=true;
  * Wake the IO thread of the queue up (its eventfd is watched by that
  * thread), for it to return the completed requests to their source.
  */
-static void
+void
 tapdisk_vbd_wake_queue(td_vbd_queue_t *queue)
 {
 	static const uint64_t token = 1;
@@ -1578,21 +1578,9 @@ __tapdisk_vbd_complete_td_request(td_vbd_queue_t* queue, td_vbd_request_t *vreq,
 
 	pthread_mutex_unlock(&queue->mutex);
 
-	/*
-	 * The IO thread of the queue returns the completed requests to their
-	 * source (blkif, blktap...) in tapdisk_server_kick_responses(). When
-	 * the request completes on another thread (e.g. a mirror write
-	 * completed by the NBD client on the main thread), wake it up:
-	 * otherwise the response waits until something else wakes it up, which
-	 * may never happen if the guest stopped sending requests (e.g. while
-	 * suspending for a live migration). Threaded drivers (qcow2) return the
-	 * responses themselves with tapdisk_vbd_kick(), which wakes the IO
-	 * thread after: waking it here too makes it race with the driver thread
-	 * for queue->mutex and doubles the wake-ups.
-	 */
-	if (notify && !tapdisk_server_in_io_thread(queue - vbd->queues) &&
-	    !(image->driver && td_flag_test(image->driver->ops->flags, TD_DRIVER_THREADED)))
+	if (notify)
 		tapdisk_vbd_wake_queue(queue);
+
 	if (err != -EBUSY) {
 		int write = treq->op == TD_OP_WRITE;
 		// FIXME: should we take a lock here for stats ? or use an atomic ?
@@ -2195,12 +2183,11 @@ tapdisk_vbd_queue_request(td_vbd_t *vbd, td_vbd_request_t *vreq, td_queue_id_t q
 }
 
 void
-tapdisk_vbd_kick(td_vbd_queue_t *queue, bool scheduler_kick)
+tapdisk_vbd_kick(td_vbd_queue_t *queue)
 {
 	struct list_head local = LIST_HEAD_INIT(local);
 	const struct list_head *list;
 	td_vbd_request_t *vreq, *prev, *next;
-	td_vbd_t *vbd = queue->vbd;
 
 	queue->kicked++;
 
@@ -2255,9 +2242,6 @@ tapdisk_vbd_kick(td_vbd_queue_t *queue, bool scheduler_kick)
 		prev->cb(prev, prev->error, prev->token, true);
 		queue->returned++;
 	}
-
-	if (scheduler_kick && td_flag_test(vbd->driver_flags, TD_DRIVER_THREADED))
-		tapdisk_vbd_wake_queue(queue);
 }
 
 int
diff --git a/drivers/tapdisk-vbd.h b/drivers/tapdisk-vbd.h
index 45f065ca..58f83ce0 100644
--- a/drivers/tapdisk-vbd.h
+++ b/drivers/tapdisk-vbd.h
@@ -221,7 +221,7 @@ int tapdisk_vbd_kill_queue(td_vbd_t *);
 int tapdisk_vbd_pause(td_vbd_t *);
 void tapdisk_vbd_squash_pause_logging(bool squash);
 int tapdisk_vbd_resume(td_vbd_t *, const char *, td_err *);
-void tapdisk_vbd_kick(td_vbd_queue_t *, bool);
+void tapdisk_vbd_kick(td_vbd_queue_t *);
 void tapdisk_vbd_process_queue(td_vbd_queue_t *);
 void tapdisk_vbd_check_state(td_vbd_t *);
 void tapdisk_vbd_free(td_vbd_t *);
@@ -250,4 +250,6 @@ int tapdisk_vbd_complete_block_status_request(const td_request_t *, int);
  * Tells whether the VBD contains at least one dead ring.
  */
 bool tapdisk_vbd_contains_dead_rings(td_vbd_t * vbd);
+
+void tapdisk_vbd_wake_queue(td_vbd_queue_t *queue);
 #endif
