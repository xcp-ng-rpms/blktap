From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Tue, 30 Jun 2026 17:13:26 +0200
Subject: [PATCH] qcow2: use idiomatic way to use pthread_cond_wait() in loop

---
 drivers/block-qcow2.c              | 14 ++++++++++----
 qcow2/lib/util/qemu-thread-posix.c |  2 +-
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/block-qcow2.c b/drivers/block-qcow2.c
index 633c788d..93ad1281 100644
--- a/drivers/block-qcow2.c
+++ b/drivers/block-qcow2.c
@@ -576,7 +576,8 @@ _qcow2_open(td_driver_t *driver, const char *name,
 	qemu_thread_create(&s->thread, "td-qcow2", qcow2_open, s,
 			   QEMU_THREAD_JOINABLE);
 
-	pthread_cond_wait(&s->cond, &s->lock);
+	while (s->open_status == 0)
+		pthread_cond_wait(&s->cond, &s->lock);
 	err = s->open_status;
 	s->open_status = 0;
 	pthread_mutex_unlock(&s->lock);
@@ -676,6 +677,7 @@ static inline void
 init_qcow2_request(struct qcow2_state *s, struct qcow2_request *req)
 {
 	req->state = s;
+	req->error = -1;
 #if DEBUGGING != 0
 	req->id = req - s->vreq_list;
 	gettimeofday(&req->allocate_tv, NULL);
@@ -998,9 +1000,11 @@ qcow2_commit(td_driver_t *driver, const char *name)
 	pthread_mutex_unlock(&s->lock);
 
 	pthread_mutex_lock(&s->commit_lock);
+
 	if (!req->done) {
 		qemu_bh_schedule(s->bh);
-		pthread_cond_wait(&s->commit_cond, &s->commit_lock);
+		while (req->error == -1)
+			pthread_cond_wait(&s->commit_cond, &s->commit_lock);
 	}
 	err = req->error;
 	pthread_mutex_unlock(&s->commit_lock);
@@ -1084,7 +1088,8 @@ qcow2_query_commit_job(td_driver_t *driver, td_query_t *query)
 	pthread_mutex_lock(&s->commit_lock);
 	if (!req->done) {
 		qemu_bh_schedule(s->bh);
-		pthread_cond_wait(&s->commit_cond, &s->commit_lock);
+		while (req->error == -1)
+			pthread_cond_wait(&s->commit_cond, &s->commit_lock);
 	}
 
 	if (query) {
@@ -1184,7 +1189,8 @@ qcow2_cancel_commit_job(td_driver_t *driver, bool wait)
 	pthread_mutex_lock(&s->commit_lock);
 	if (!req->done) {
 		qemu_bh_schedule(s->bh);
-		pthread_cond_wait(&s->commit_cond, &s->commit_lock);
+		while (req->error == -1)
+			pthread_cond_wait(&s->commit_cond, &s->commit_lock);
 	}
 	err = req->error;
 	pthread_mutex_unlock(&s->commit_lock);
diff --git a/qcow2/lib/util/qemu-thread-posix.c b/qcow2/lib/util/qemu-thread-posix.c
index 78e72e34..45b3fa65 100644
--- a/qcow2/lib/util/qemu-thread-posix.c
+++ b/qcow2/lib/util/qemu-thread-posix.c
@@ -336,7 +336,7 @@ static inline void qemu_futex_wait(QemuEvent *ev, unsigned val)
 {
     assert(ev->initialized);
     pthread_mutex_lock(&ev->lock);
-    if (ev->value == val) {
+    while (ev->value == val) {
         pthread_cond_wait(&ev->cond, &ev->lock);
     }
     pthread_mutex_unlock(&ev->lock);
