From c120acae462432e91d46998a6c0b59c11c77eca6 Mon Sep 17 00:00:00 2001
From: Yann Dirson <yann.dirson@vates.tech>
Date: Wed, 15 Oct 2025 14:01:08 +0200
Subject: [PATCH] Use memory barriers defined by xen-barrier.h

This gives us the necessary definitions for arm64.

Signed-off-by: Yann Dirson <yann.dirson@vates.tech>
---
 include/blktap-xenif.h | 8 +-------
 1 file changed, 1 insertion(+), 7 deletions(-)

diff --git a/include/blktap-xenif.h b/include/blktap-xenif.h
index da0deef..e00d1d2 100644
--- a/include/blktap-xenif.h
+++ b/include/blktap-xenif.h
@@ -14,12 +14,6 @@
 
 /* Get the correct defines for memory barriers - do not fall
  * back to those provided by the kernel */
-#ifdef __i386__
-#define xen_mb()  asm volatile ( "lock addl $0, -4(%%esp)" ::: "memory" )
-#else
-#define xen_mb()  asm volatile ( "lock addl $0, -32(%%rsp)" ::: "memory" )
-#endif
-#define xen_rmb() asm volatile ("" ::: "memory")
-#define xen_wmb() asm volatile ("" ::: "memory")
+#include <xen-barrier.h>
 
 #endif /* __BLKTAPXENIF_H__ */
-- 
2.47.3

