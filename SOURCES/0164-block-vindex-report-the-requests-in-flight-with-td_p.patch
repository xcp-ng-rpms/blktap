From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Wed, 21 Oct 2026 16:27:39 +0200
Subject: [PATCH] block-vindex: report the requests in flight with td_pending

block-vindex queues its own tiocbs, and vhd_index_signal_completion()
still drops its file reference and frees the request after
td_complete_request(): like aio, it needs td_pending so that a pause
waits for it before closing the driver.

The metadata reads use the same request slots, so they are counted too.

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/block-vindex.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/block-vindex.c b/drivers/block-vindex.c
index 419afdfa..c88213b0 100644
--- a/drivers/block-vindex.c
+++ b/drivers/block-vindex.c
@@ -892,6 +892,14 @@ vhd_index_debug(td_driver_t *driver)
 	}
 }
 
+static int
+vhd_index_pending(td_driver_t *driver)
+{
+	vhd_index_t *index = driver->data;
+
+	return VHD_INDEX_REQUESTS - index->requests_free_cnt;
+}
+
 struct tap_disk tapdisk_vhd_index = {
 	.disk_type                = "tapdisk_vhd_index",
 	.flags                    = 0,
@@ -902,5 +910,6 @@ struct tap_disk tapdisk_vhd_index = {
 	.td_queue_write           = vhd_index_queue_write,
 	.td_get_parent_id         = vhd_index_get_parent_id,
 	.td_validate_parent       = vhd_index_validate_parent,
+	.td_pending               = vhd_index_pending,
 	.td_debug                 = vhd_index_debug,
 };
