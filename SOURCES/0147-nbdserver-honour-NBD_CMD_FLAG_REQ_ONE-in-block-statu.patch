From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Fri, 2 Oct 2026 13:03:26 +0200
Subject: [PATCH] nbdserver: honour NBD_CMD_FLAG_REQ_ONE in block status
 replies

When a client sets NBD_CMD_FLAG_REQ_ONE on NBD_CMD_BLOCK_STATUS, the
server must not return more than one extent descriptor. Now that the
command flags are decoded, keep them in the request and truncate the
reply to the first extent when REQ_ONE is set. Otherwise qemu treats
a multi-extent reply as a protocol error and drops the connection.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/tapdisk-nbdserver.c    | 7 +++++++
 drivers/tapdisk-protocol-new.h | 2 ++
 2 files changed, 9 insertions(+)

diff --git a/drivers/tapdisk-nbdserver.c b/drivers/tapdisk-nbdserver.c
index 3071c3de..7e9f2291 100644
--- a/drivers/tapdisk-nbdserver.c
+++ b/drivers/tapdisk-nbdserver.c
@@ -80,6 +80,7 @@ uint16_t gflags = (NBD_FLAG_FIXED_NEWSTYLE | NBD_FLAG_NO_ZEROES);
 struct td_nbdserver_req {
 	td_vbd_request_t        vreq;
 	char                    id[16];
+	uint16_t                flags;
 	struct td_iovec         iov;
 	/* data buffer kept between two uses of this request */
 	void                   *buf;
@@ -929,6 +930,11 @@ __tapdisk_nbdserver_block_status_cb(td_vbd_request_t *vreq, int err,
 	td_nbdserver_client_t *client = token;
 	td_nbdserver_req_t *req = container_of(vreq, td_nbdserver_req_t, vreq);
 	tapdisk_extents_t* extents = (tapdisk_extents_t *)(vreq->data);
+
+	/* With REQ_ONE, the reply must not hold more than one extent */
+	if ((req->flags & NBD_CMD_FLAG_REQ_ONE) && extents->count > 1)
+		extents->count = 1;
+
 	send_structured_reply_block_status (client->client_fd, req->id, extents);
 	free_extents(extents);
 	tapdisk_nbd_server_free_vreq(client, vreq, true);
@@ -1264,6 +1270,7 @@ static td_vbd_request_t *create_request_vreq(
 
 	nbdreq_init(req);
 	memcpy(req->id, request.handle, sizeof(request.handle));
+	req->flags = request.flags;
 
 	req->iov.base = nbdreq_buffer_get(req, len);
 	if (!req->iov.base) {
diff --git a/drivers/tapdisk-protocol-new.h b/drivers/tapdisk-protocol-new.h
index bac9fdd2..27fdad9b 100644
--- a/drivers/tapdisk-protocol-new.h
+++ b/drivers/tapdisk-protocol-new.h
@@ -60,6 +60,8 @@
 #define NBD_FLAG_SEND_CACHE        (1 << 10)
 #define NBD_FLAG_SEND_FAST_ZERO    (1 << 11)
 
+#define NBD_CMD_FLAG_REQ_ONE       (1 << 3)
+
 #define NBD_OPT_EXPORT_NAME        1
 #define NBD_OPT_ABORT              2
 #define NBD_OPT_LIST               3
