From 114ff18b935dd05e3ae003c0a22e8efb71f2ecc0 Mon Sep 17 00:00:00 2001
From: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
Date: Thu, 10 Sep 2026 10:16:31 +0200
Subject: [PATCH] qcow2: only check overlap which can be done in constant time

On big qcow2, some linear time check can take some time.
Also disable checks associated with internal snapshot that we
don't use.

Signed-off-by: Anthoine Bourgeois <anthoine.bourgeois@vates.tech>
---
 drivers/block-qcow2.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/block-qcow2.c b/drivers/block-qcow2.c
index 99c0e7e2..f3656ad3 100644
--- a/drivers/block-qcow2.c
+++ b/drivers/block-qcow2.c
@@ -310,6 +310,10 @@ qcow2_open(void *opaque)
 	qdict_put_str(file_layer, "filename", name);
 
 	qdict_put_str(options, "driver", "qcow2");
+        // Disable linear time overlap checks
+        // Disable snapshot-table as we don't use internal snapshots
+	qdict_put_str(options, "overlap-check", "constant");
+	qdict_put_str(options, "overlap-check.snapshot-table", "off");
 
 	if (has_aio_native) {
 		has_discard = true;
