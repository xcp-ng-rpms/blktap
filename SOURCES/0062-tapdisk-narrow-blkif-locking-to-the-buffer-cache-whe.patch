From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
Date: Thu, 17 Sep 2026 18:15:37 +0200
Subject: [PATCH] tapdisk: narrow blkif locking to the buffer cache when
 parsing

Only the buffer cache needs the blkif mutex when a request is parsed.
The rest of the work only touches data owned by the request, or
blkif fields that do not change once the ring is connected, so it
can run without the lock.

guest_copy2() can take a long time on write requests, as it copies
the data from the guest. Holding the lock during this copy delayed the
completion of other writes.

Signed-off-by: Emmanuel Varagnat <emmanuel.varagnat@vates.tech>
---
 drivers/td-req.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/td-req.c b/drivers/td-req.c
index 1b3a40b5..3d4177a3 100644
--- a/drivers/td-req.c
+++ b/drivers/td-req.c
@@ -630,7 +630,7 @@ __tapdisk_xenblkif_request_cb(struct td_vbd_request * const vreq,
 
 
 static inline int
-tapdisk_xenblkif_parse_request_locked(struct td_xenblkif * const blkif,
+tapdisk_xenblkif_parse_request(struct td_xenblkif * const blkif,
         struct td_xenblkif_req * const req)
 {
     td_vbd_request_t *vreq;
@@ -646,7 +646,10 @@ tapdisk_xenblkif_parse_request_locked(struct td_xenblkif * const blkif,
     vreq = &req->vreq;
     ASSERT(vreq);
 
+
+    pthread_mutex_lock(&blkif->mutex);
     req->vma = td_xenblkif_bufcache_get(blkif);
+    pthread_mutex_unlock(&blkif->mutex);
     if (unlikely(!req->vma)) {
         err = errno;
         RING_ERR(blkif, "errno %d: invalid vma\n", err);
@@ -818,9 +821,7 @@ tapdisk_xenblkif_make_vbd_request(struct td_xenblkif * const blkif,
     }
 
     if (likely(req->msg.nr_segments)) {
-        pthread_mutex_lock(&blkif->mutex);
-        err = tapdisk_xenblkif_parse_request_locked(blkif, req);
-        pthread_mutex_unlock(&blkif->mutex);
+        err = tapdisk_xenblkif_parse_request(blkif, req);
     /*
      * If we only got one request from the ring and that was a barrier one,
      * check whether the barrier requests completion conditions are satisfied
