+#doc = README README.md LICENSE CONTRIB MAINTAINERS
diff --git a/mockatests/cbt/meson.build b/mockatests/cbt/meson.build
new file mode 100644
index 00000000..391b61d8
--- /dev/null
+++ b/mockatests/cbt/meson.build
@@ -0,0 +1,35 @@
+
+test_cbt_util_sources = [
+  'test-cbt-util.c',
+  'test-cbt-util-commands.c',
+  'test-cbt-util-set.c',
+  'test-cbt-util-get.c',
+  'test-cbt-util-create.c',
+  'test-cbt-util-coalesce.c',
+  ]
+
+executable('test-cbt-util', test_cbt_util_sources,
+  include_directories : [
+    incdir,
+    mockatests_include,
+    cbt_include,
+  ],
+  dependencies : [
+    cmocka_dep,
+    uuid_dep,
+  ],
+  link_with : [
+    cbtutil_slib,
+    wrappers_slib,
