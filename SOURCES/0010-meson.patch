diff --git a/cbt/meson.build b/cbt/meson.build
new file mode 100644
index 00000000..3481fed1
--- /dev/null
+++ b/cbt/meson.build
@@ -0,0 +1,13 @@
+cbt_include = include_directories('.')
+
+cbtutil_sources = 'cbt-util.c'
+
+cbtutil_slib = static_library('cbtutil',
+  cbtutil_sources,
+  include_directories : incdir)
+
+cbt_util_sources = 'main.c'
+
+executable('cbt-util', cbt_util_sources,
+  dependencies : uuid_dep,
+  link_with : cbtutil_slib)
diff --git a/control/meson.build b/control/meson.build
new file mode 100644
index 00000000..acea5673
--- /dev/null
+++ b/control/meson.build
@@ -0,0 +1,40 @@
+blktapctl_sources = [
+    'tap-ctl-ipc.c',
+    'tap-ctl-list.c',
+    'tap-ctl-allocate.c',
+    'tap-ctl-free.c',
+    'tap-ctl-create.c',
+    'tap-ctl-destroy.c',
+    'tap-ctl-spawn.c',
+    'tap-ctl-attach.c',
+    'tap-ctl-detach.c',
+    'tap-ctl-open.c',
+    'tap-ctl-close.c',
+    'tap-ctl-pause.c',
+    'tap-ctl-unpause.c',
+    'tap-ctl-stats.c',
+    'tap-ctl-xen.c',
+    'tap-ctl-info.c',
+    ]
+
+c_flags = [
+  '-D_GNU_SOURCE',
+  '-DTAPCTL',
+  '-DTAPDISK_EXEC="tapdisk"',
+  '-DTAPDISK_EXECDIR="../drivers"',
+]
+
+blktapctl_libs = both_libraries('blktapctl',
+  blktapctl_sources,
+  include_directories : incdir,
+  c_args : c_flags,
+  version : '0.1.1',
+)
+
+tap_ctl_sources = 'tap-ctl.c'
+
+executable('tap-ctl', tap_ctl_sources,
+  link_with : blktapctl_libs.get_shared_lib(),
+  include_directories : incdir,
+  c_args : c_flags,
+)
