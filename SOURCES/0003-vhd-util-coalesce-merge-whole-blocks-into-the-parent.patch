+
+/* Merge the child block into an allocated parent block */
+static int
+coalesce_merge_parent_block(struct coalesce_ctx *c, uint64_t block)
+{
+	int err;
+	uint32_t i;
+	int changed;
+	vhd_context_t *parent = c->parent;
+	uint64_t blk = parent->bat.bat[block];
+	int full = (vhd_has_batmap(parent) &&
+		    vhd_batmap_test(parent, &parent->batmap, block));
+
+	err = coalesce_write_runs(c, coalesce_write_run_block,
+				  blk + parent->bm_secs);
+	if (err || full)
+		return err;
+
+	err = vhd_pread(parent, c->parent_map, c->bm_bytes,
+			vhd_sectors_to_bytes(blk));
+	if (err)
+		return err;
+
+	changed = 0;
+	for (i = 0; i < (parent->spb >> 3); i++) {
+		char merged = c->parent_map[i] | c->child_map[i];
+
+		if (merged != c->parent_map[i]) {
+			c->parent_map[i] = merged;
+			changed = 1;
+		}
+	}
+
+	if (!changed)
+		return 0;
+
+	err = vhd_pwrite(parent, c->parent_map, c->bm_bytes,
+			 vhd_sectors_to_bytes(blk));
+	if (err)
+		return err;
+
+	if (vhd_has_batmap(parent) && bitmap_full(c->parent_map, parent->spb)) {
+		vhd_batmap_set(parent, &parent->batmap, block);
+		c->batmap_dirty = 1;
+	}
+
+	return 0;
+}
+
+/**
+ * Coalesce a VHD allocation block
+ *
+ * @param[in] c the coalescing state
+ * @param[in] block the allocation block number to coalesce
+ * @return the number of sectors coalesced or negative errno on failure
+ */
+static int64_t
+vhd_util_coalesce_block(struct coalesce_ctx *c, uint64_t block)
+{
+	int err;
+	int64_t count;
+	uint32_t first, last;
+	vhd_context_t *vhd = c->child;
+	vhd_context_t *parent = c->parent;
+	uint64_t sec = block * vhd->spb;
+
+	if (vhd->bat.bat[block] == DD_BLK_UNUSED)
+		return 0;
+
+	count = coalesce_read_child(c, block, &first, &last);
+	if (count <= 0)
+		return count;
+
+	if (parent->file &&
+	    vhd_sectors_to_bytes(sec + last) > parent->footer.curr_size)
+		return -ERANGE;
+
+	if (!parent->file || !vhd_type_dynamic(parent))
+		err = coalesce_write_runs(c, coalesce_write_run_linear, sec);
+	else if (!c->fast)
+		err = coalesce_write_runs(c, coalesce_write_run_io, sec);
+	else if (block >= parent->bat.entries)
+		err = -ERANGE;
+	else if (parent->bat.bat[block] == DD_BLK_UNUSED)
+		err = coalesce_alloc_parent_block(c, block);
+	else
+		err = coalesce_merge_parent_block(c, block);
+
+	return err ? err : count;
 }
 
 /**
