 vhd/lib/vhd-util-coalesce.c | 578 +++++++++++++++++++++++++++++++-----
 1 file changed, 498 insertions(+), 80 deletions(-)

diff --git a/vhd/lib/vhd-util-coalesce.c b/vhd/lib/vhd-util-coalesce.c
index 8bcfb79f..f12a545a 100644
--- a/vhd/lib/vhd-util-coalesce.c
+++ b/vhd/lib/vhd-util-coalesce.c
@@ -38,123 +38,524 @@
 #include <stdlib.h>
 #include <unistd.h>
 #include <limits.h>
+#include <string.h>
 
 #include "libvhd.h"
 #include "canonpath.h"
 
+/*
+ * Coalescing state, set up once and reused for every block.
+ *
+ * Writing to a dynamic parent through vhd_io_write() costs, for every
+ * contiguous run of sectors, a parent bitmap read and write, a full BAT
+ * scan to find the end of data and a footer rewrite, plus a full BAT
+ * (and batmap) rewrite whenever a block gets allocated or filled.
+ * Instead, a dynamic parent with the same block size as the child is
+ * updated here one block at a time: the end of data is cached, only
+ * the modified BAT sector is written and the batmap is flushed once at
+ * the end. A crash midway leaves the parent consistent: data and
+ * bitmaps reach the disk before the BAT entry pointing to them, and a
+ * batmap bit left unset only costs a bitmap lookup.
+ */
+struct coalesce_ctx {
+	vhd_context_t *child;
+	vhd_context_t *parent;      /* parent->file is NULL if raw */
+	int            parent_fd;   /* raw parent */
+	int            sparse;
+	int            fast;        /* per-block merge into dynamic parent */
+
+	off64_t        child_end;   /* child footer offset */
+	off64_t        parent_eod;  /* parent end of data, cached */
+	uint32_t       pad_secs;    /* room for the alignment gap */
+	uint32_t       bm_bytes;
+
+	char          *child_map;
+	char          *parent_map;
+	/* [pad][bitmap][data][footer], written as one on allocation */
+	char          *buf;
+	char          *bitmap;
+	char          *data;
+
+	int            allocated;
+	int            batmap_dirty;
+};
+
 static int
 __raw_io_write(int fd, char* buf, uint64_t sec, uint32_t secs)
 {
-	off64_t off;
 	ssize_t ret;
 
 	errno = 0;
-	off = lseek64(fd, (off64_t)vhd_sectors_to_bytes(sec), SEEK_SET);
-	if (off == (off64_t)-1) {
-		printf("raw parent: seek(0x%08"PRIx64") failed: %d\n",
-		       vhd_sectors_to_bytes(sec), -errno);
-		return -errno;
-	}
-
-	ret = write(fd, buf, vhd_sectors_to_bytes(secs));
+	ret = pwrite(fd, buf, vhd_sectors_to_bytes(secs),
+		     (off64_t)vhd_sectors_to_bytes(sec));
 	if (ret == vhd_sectors_to_bytes(secs))
 		return 0;
 
-	printf("raw parent: write of 0x%"PRIx64" returned %zd, errno: %d\n",
-	       vhd_sectors_to_bytes(secs), ret, -errno);
+	printf("raw parent: write of 0x%"PRIx64" at 0x%08"PRIx64" returned %zd, "
+	       "errno: %d\n", vhd_sectors_to_bytes(secs),
+	       vhd_sectors_to_bytes(sec), ret, -errno);
 	return (errno ? -errno : -EIO);
 }
 
 /**
- * Coalesce a VHD allocation block
+ * Find the next run of set bits in a block bitmap
  *
- * @param[in] vhd the VHD being coalesced
- * @param[in] parent the VHD to coalesce to unless raw
- * @param[in] parent_fd raw FD to coalesce to unless VHD parent
- * @param[in] parent block the allocation block number to coalese
- * @return the number of sectors coalesced or negative errno on failure
+ * @param[in] map the bitmap
+ * @param[in] spb the number of sectors per block
+ * @param[in] i the sector to start searching from
+ * @param[out] len the length of the run found
+ * @return the first sector of the run, or spb if there is none
+ */
+static uint32_t
+bitmap_next_run(const char *map, uint32_t spb, uint32_t i, uint32_t *len)
+{
+	const unsigned char *m = (const unsigned char *)map;
+	uint32_t end;
+
+	while (i < spb) {
+		if (!(i & 7) && i + 8 <= spb && !m[i >> 3])
+			i += 8;
+		else if (test_bit(map, i))
+			break;
+		else
+			i++;
+	}
+
+	for (end = i; end < spb; ) {
+		if (!(end & 7) && end + 8 <= spb && m[end >> 3] == 0xff)
+			end += 8;
+		else if (test_bit(map, end))
+			end++;
+		else
+			break;
+	}
+
+	*len = end - i;
+	return i;
+}
+
+static int
+bitmap_full(const char *map, uint32_t spb)
+{
+	uint32_t len;
+
+	return bitmap_next_run(map, spb, 0, &len) == 0 && len == spb;
+}
+
+static int
+coalesce_ctx_init(struct coalesce_ctx *c, vhd_context_t *child,
+		  vhd_context_t *parent, int parent_fd, int sparse)
+{
+	int err;
+	size_t size;
+	uint32_t bm_secs, spp;
+	vhd_footer_t *footer;
+
+	memset(c, 0, sizeof(*c));
+	c->child     = child;
+	c->parent    = parent;
+	c->parent_fd = parent_fd;
+	c->sparse    = sparse;
+
+	err = vhd_footer_offset_at_eof(child, &c->child_end);
+	if (err)
+		return err;
+
+	if (parent->file && vhd_type_dynamic(parent)) {
+		err = vhd_get_bat(parent);
+		if (err)
+			return err;
+
+		if (vhd_has_batmap(parent)) {
+			err = vhd_get_batmap(parent);
+			if (err)
+				return err;
+		}
+
+		c->fast = (parent->spb == child->spb &&
+			   parent->bm_secs == child->bm_secs);
+		if (c->fast) {
+			err = vhd_end_of_data(parent, &c->parent_eod);
+			if (err)
+				return err;
+		}
+	}
+
+	spp        = getpagesize() >> VHD_SECTOR_SHIFT;
+	bm_secs    = child->bm_secs;
+	c->bm_bytes   = vhd_sectors_to_bytes(bm_secs);
+	c->pad_secs   = spp;
+
+	err = posix_memalign((void **)&c->child_map, 4096, c->bm_bytes);
+	if (err)
+		goto fail;
+
+	err = posix_memalign((void **)&c->parent_map, 4096, c->bm_bytes);
+	if (err)
+		goto fail;
+
+	size = vhd_sectors_to_bytes(c->pad_secs + bm_secs + child->spb + 1);
+	err  = posix_memalign((void **)&c->buf, 4096, size);
+	if (err)
+		goto fail;
+
+	c->bitmap = c->buf + vhd_sectors_to_bytes(c->pad_secs);
+	c->data   = c->bitmap + c->bm_bytes;
+
+	if (c->fast) {
+		/* trailing footer written along with each allocated block */
+		footer = (vhd_footer_t *)(c->data +
+					  vhd_sectors_to_bytes(child->spb));
+		memcpy(footer, &parent->footer, sizeof(*footer));
+		footer->checksum = vhd_checksum_footer(footer);
+		vhd_footer_out(footer);
+	}
+
+	return 0;
+
+fail:
+	free(c->child_map);
+	free(c->parent_map);
+	c->child_map = c->parent_map = NULL;
+	return -err;
+}
+
+static void
+coalesce_ctx_free(struct coalesce_ctx *c)
+{
+	free(c->child_map);
+	free(c->parent_map);
+	free(c->buf);
+}
+
+/*
+ * Write back the parent metadata left pending by the per-block merge.
+ */
+static int
+coalesce_ctx_flush(struct coalesce_ctx *c)
+{
+	int err;
+
+	if (c->batmap_dirty) {
+		err = vhd_write_batmap(c->parent, &c->parent->batmap);
+		if (err)
+			return err;
+		c->batmap_dirty = 0;
+	}
+
+	if (c->allocated) {
+		/* also truncates the file and updates the backup footer */
+		err = vhd_write_footer(c->parent, &c->parent->footer);
+		if (err)
+			return err;
+		c->allocated = 0;
+	}
+
+	return 0;
+}
+
