+}
+
+/* Raw or fixed parent: base is the first sector of the block */
+static int
+coalesce_write_run_linear(struct coalesce_ctx *c, uint64_t base,
+			  uint32_t i, uint32_t secs)
+{
+	char *buf = c->data + vhd_sectors_to_bytes(i);
 
-		for (secs = 0; i + secs < vhd->spb; secs++)
-			if (!vhd_bitmap_test(vhd, map, i + secs))
-				break;
