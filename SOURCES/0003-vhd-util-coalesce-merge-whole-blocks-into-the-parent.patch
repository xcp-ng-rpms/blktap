-	if (vhd->bat.bat[block] == DD_BLK_UNUSED)
+	count = 0;
+	start = bitmap_next_run(c->child_map, vhd->spb, 0, &len);
+	if (start == vhd->spb)
 		return 0;
 
-	if (vhd_has_batmap(vhd) && vhd_batmap_test(vhd, &vhd->batmap, block)) {
-		err = vhd_read_block(vhd, block, &buf);
+	for (i = start, end = start; i < vhd->spb; i += len) {
+		i = bitmap_next_run(c->child_map, vhd->spb, i, &len);
+		if (i == vhd->spb)
+			break;
+		count += len;
+		end    = i + len;
+	}
+
+	off   = vhd_sectors_to_bytes(blk + vhd->bm_secs + start);
+	size  = vhd_sectors_to_bytes(end - start);
+	avail = size;
+	if (off + (off64_t)size > c->child_end)
+		avail = (c->child_end > off ? c->child_end - off : 0);
+
+	if (avail) {
+		err = vhd_pread(vhd, c->data + vhd_sectors_to_bytes(start),
+				avail, off);
 		if (err)
-			goto done;
+			return err;
+	}
+	memset(c->data + vhd_sectors_to_bytes(start) + avail, 0, size - avail);
 
-		if (parent->file)
-			err = vhd_io_write(parent, buf, sec, vhd->spb);
-		else
-			err = __raw_io_write(parent_fd, buf, sec, vhd->spb);
+	*first = start;
+	*last  = end;
+	return count;
+}
 
-		if (err == 0)
-			coalesced_size = vhd->spb;
+/* Zero the data buffer outside of the sectors set in the child bitmap */
+static void
+coalesce_zero_holes(struct coalesce_ctx *c)
+{
+	uint32_t i, len, prev, spb = c->child->spb;
 
-		goto done;
+	for (i = 0, prev = 0; i < spb; i += len) {
+		i = bitmap_next_run(c->child_map, spb, i, &len);
+		memset(c->data + vhd_sectors_to_bytes(prev), 0,
+		       vhd_sectors_to_bytes(i - prev));
+		prev = i + len;
 	}
+}
 
-	err = vhd_read_bitmap(vhd, block, &map);
-	if (err)
-		goto done;
+/* Write each run of the child block at the given parent sector */
+static int
+coalesce_write_runs(struct coalesce_ctx *c, int (*write_run)
+		    (struct coalesce_ctx *, uint64_t, uint32_t, uint32_t),
+		    uint64_t base)
+{
+	int err;
+	uint32_t i, len, spb = c->child->spb;
 
