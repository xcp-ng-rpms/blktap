+ * sectors, in at most two I/Os. Returns the number of sectors set.
  */
 static int64_t
-vhd_util_coalesce_block(vhd_context_t *vhd, vhd_context_t *parent,
-			int parent_fd, uint64_t block)
+coalesce_read_child(struct coalesce_ctx *c, uint64_t block,
