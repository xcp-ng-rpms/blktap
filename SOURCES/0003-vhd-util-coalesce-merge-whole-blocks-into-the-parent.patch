-				  buf + vhd_sectors_to_bytes(i));
+	return vhd_pwrite(c->parent, buf, vhd_sectors_to_bytes(secs),
+			  vhd_sectors_to_bytes(base + i));
+}
+
+/* Dynamic parent with a different block size: generic slow path */
+static int
+coalesce_write_run_io(struct coalesce_ctx *c, uint64_t base,
+		      uint32_t i, uint32_t secs)
+{
+	return vhd_io_write(c->parent, c->data + vhd_sectors_to_bytes(i),
+			    base + i, secs);
+}
+
+/* Dynamic parent: base is the parent block data offset in sectors */
+static int
+coalesce_write_run_block(struct coalesce_ctx *c, uint64_t base,
+			 uint32_t i, uint32_t secs)
+{
+	return vhd_pwrite(c->parent, c->data + vhd_sectors_to_bytes(i),
+			  vhd_sectors_to_bytes(secs),
+			  vhd_sectors_to_bytes(base + i));
+}
+
+/*
+ * Allocate a parent block at the cached end of data and write its
+ * bitmap and data, along with the trailing footer for a file, before
+ * pointing the BAT to it.
+ */
+static int
+coalesce_alloc_parent_block(struct coalesce_ctx *c, uint64_t block)
+{
+	int err;
+	off64_t off;
+	char *start;
+	size_t size;
+	uint64_t max;
+	uint32_t gap, spp, secs;
+	vhd_context_t *parent = c->parent;
+
+	spp = getpagesize() >> VHD_SECTOR_SHIFT;
+	off = c->parent_eod;
+	max = off >> VHD_SECTOR_SHIFT;
+
+	/* data region of segment should begin on page boundary */
+	gap = 0;
+	if ((max + parent->bm_secs) % spp) {
+		gap  = spp - ((max + parent->bm_secs) % spp);
+		max += gap;
+	}
+
+	if (max > UINT32_MAX)
+		return -EIO;
+
+	memset(c->bitmap - vhd_sectors_to_bytes(gap), 0,
+	       vhd_sectors_to_bytes(gap));
+	memcpy(c->bitmap, c->child_map, c->bm_bytes);
+	start = c->bitmap - vhd_sectors_to_bytes(gap);
+
+	if (c->sparse && !bitmap_full(c->child_map, parent->spb)) {
+		/* leave the unwritten sectors unallocated in the file */
+		err = vhd_pwrite(parent, start,
+				 vhd_sectors_to_bytes(gap + parent->bm_secs), off);
 		if (err)
